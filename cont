#!/usr/bin/env bash
# cont — a thin wrapper around `tart` for macOS-on-macOS isolated environments.
#
# Workflow:
#   cont pull               # fetch the upstream base image (one-time, ~30GB)
#   cont up dev             # clone base -> "dev" and boot it
#   cont ssh dev            # admin/admin
#   cont snapshot dev gold  # APFS-clone "dev" into "gold" as your golden image
#   cont base gold          # tell cont to clone from "gold" going forward
#   cont reset dev          # nuke "dev" and reclone fresh from the configured base
#   cont down dev           # stop
#   cont rm dev             # delete

set -euo pipefail

# Resolve the directory this script lives in, following symlinks (so
# `./cont` and the /usr/local/bin/cont symlink both find provision.sh).
self="${BASH_SOURCE[0]}"
while [[ -L "$self" ]]; do
  link="$(readlink "$self")"
  if [[ "$link" = /* ]]; then self="$link"
  else self="$(cd "$(dirname "$self")" && pwd)/$(basename "$link")"
  fi
done
SCRIPT_DIR="$(cd "$(dirname "$self")" && pwd)"

UPSTREAM_BASE="ghcr.io/cirruslabs/macos-tahoe-base:latest"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/cont"
BASE_FILE="$CONFIG_DIR/base"
SPEC_DIR="$CONFIG_DIR/specs"
CLAUDE_TOKEN_FILE="$CONFIG_DIR/claude-token"
CLAUDE_CREDS_FILE="$CONFIG_DIR/claude-credentials.json"
CLAUDE_ACCOUNT_FILE="$CONFIG_DIR/claude-account.json"
SSH_USER="admin"
SSH_PASS="admin"

mkdir -p "$CONFIG_DIR" "$SPEC_DIR"

spec_file() { echo "$SPEC_DIR/$1.conf"; }

# Read one key from a spec file. Lines look like `cpu=8`. Blank lines and
# `# comments` are ignored. Returns empty string if missing.
spec_get() {
  local file="$1" key="$2"
  [[ -f "$file" ]] || return 0
  awk -F= -v k="$key" '
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }
    {
      gsub(/[[:space:]]/, "", $1)
      if ($1 == k) {
        sub(/^[^=]*=/, "")
        sub(/^[[:space:]]+/, ""); sub(/[[:space:]]+$/, "")
        print; exit
      }
    }' "$file"
}

# Apply the spec file for $1 to the VM via `tart set`. VM must be stopped.
apply_spec() {
  local name="$1" file; file="$(spec_file "$name")"
  [[ -f "$file" ]] || return 0
  if vm_running "$name"; then
    echo "warning: $name is running — spec will apply on next stop/start" >&2
    return 0
  fi
  local cpu mem disp disk args=()
  cpu="$(spec_get "$file" cpu)"
  mem="$(spec_get "$file" memory)"
  disp="$(spec_get "$file" display)"
  disk="$(spec_get "$file" disk)"
  [[ -n "$cpu"  ]] && args+=(--cpu "$cpu")
  [[ -n "$mem"  ]] && args+=(--memory "$mem")
  [[ -n "$disp" ]] && args+=(--display "$disp")
  [[ -n "$disk" ]] && args+=(--disk-size "$disk")
  if (( ${#args[@]} > 0 )); then
    echo "applying spec $(basename "$file") -> $name: ${args[*]}"
    tart set "$name" "${args[@]}"
  fi
}

current_base() {
  if [[ -f "$BASE_FILE" ]]; then cat "$BASE_FILE"; else echo "$UPSTREAM_BASE"; fi
}

vm_exists() {
  tart list --quiet --source local 2>/dev/null | grep -Fxq "$1"
}

vm_running() {
  tart list 2>/dev/null \
    | awk -v n="$1" '$1=="local" && $2==n && $NF=="running" { f=1 } END { exit !f }'
}

require_name() {
  if [[ -z "${1:-}" ]]; then echo "error: VM name required" >&2; exit 2; fi
}

ensure_sshpass() {
  command -v sshpass >/dev/null || {
    echo "installing sshpass (needed for non-interactive ssh)..." >&2
    brew install esolitos/ipa/sshpass >/dev/null
  }
}

has_valid_claude_token() {
  [[ -f "$CLAUDE_TOKEN_FILE" ]] || return 1
  local t; t="$(tr -d '[:space:]' < "$CLAUDE_TOKEN_FILE" 2>/dev/null)"
  # Accept any sk-ant-oat... prefix (e.g. sk-ant-oat01_...).
  [[ "$t" == sk-ant-oat* ]] || return 1
  # If we have the keychain blob, also gate on expiresAt — a file on disk
  # with the right prefix tells us nothing about whether the access token
  # is still live, and stale tokens shipped to a VM fail with 401.
  [[ -f "$CLAUDE_CREDS_FILE" ]] || return 0
  python3 - "$CLAUDE_CREDS_FILE" <<'PY' >/dev/null 2>&1 || return 1
import json, sys, time
d = json.load(open(sys.argv[1]))
exp = d.get("claudeAiOauth", {}).get("expiresAt", 0)
sys.exit(0 if exp and exp/1000 > time.time() else 1)
PY
}

# Pull the OAuth token from the host's macOS keychain entry that Claude Code
# writes ("Claude Code-credentials"). Returns 0 and prints the token on stdout
# if a well-formed sk-ant-oat-... value is present, else returns 1.
read_claude_token_from_keychain() {
  local json token
  json="$(security find-generic-password -s 'Claude Code-credentials' -w 2>/dev/null)" || return 1
  [[ -n "$json" ]] || return 1
  token="$(printf '%s' "$json" | python3 -c \
    'import json,sys
try:
  d=json.load(sys.stdin)
  t=d.get("claudeAiOauth",{}).get("accessToken","")
  print(t if t.startswith("sk-ant-oat") else "")
except Exception:
  pass' 2>/dev/null)"
  [[ -n "$token" ]] || return 1
  printf '%s\n' "$token"
}

save_claude_token() {
  local token="$1"
  ( umask 077; printf '%s\n' "$token" > "$CLAUDE_TOKEN_FILE" )
  chmod 600 "$CLAUDE_TOKEN_FILE"
}

# Trigger Claude Code's internal keychain refresh on the host so the access
# token in "Claude Code-credentials" is rotated to a fresh one. Access
# tokens expire in ~hours; the refreshToken is long-lived. Any claude
# invocation that opens its config picks up the refresh as a side effect —
# `claude --version` is the cheapest. Best-effort; ignore failures.
refresh_host_claude_keychain() {
  command -v claude >/dev/null || return 0
  claude --version >/dev/null 2>&1 || true
}

# Save the full keychain credential blob so the VM can re-create an
# identical keychain entry. Just the access token isn't enough — Claude
# Code's interactive UI on macOS reads from the keychain entry
# "Claude Code-credentials", which is a JSON object with refreshToken,
# scopes, etc. Refresh first so we ship a non-expired access token.
save_claude_credentials_blob() {
  refresh_host_claude_keychain
  local json
  json="$(security find-generic-password -s 'Claude Code-credentials' -w 2>/dev/null)" || return 1
  [[ -n "$json" ]] || return 1
  ( umask 077; printf '%s' "$json" > "$CLAUDE_CREDS_FILE" )
  chmod 600 "$CLAUDE_CREDS_FILE"
}

# Extract the auth/onboarding-state fields from the host's ~/.claude.json.
# Claude Code's interactive UI gates "logged in?" on the presence of
# `oauthAccount` (and friends) in this file — even when the keychain
# entry exists. Without this, fresh VMs always show the login picker.
# We deliberately copy ONLY auth-state keys: project paths, history,
# repo paths, and other personal/host-specific state stay on the host.
save_claude_account_blob() {
  [[ -f "$HOME/.claude.json" ]] || return 1
  python3 - "$HOME/.claude.json" "$CLAUDE_ACCOUNT_FILE" <<'PY' || return 1
import json, os, sys
src_path, dst_path = sys.argv[1], sys.argv[2]
src = json.load(open(src_path))
# Auth / "is logged in?" gate.
auth_keys = [
    "oauthAccount",
    "hasAvailableSubscription",
    "claudeCodeFirstTokenDate",
    "isQualifiedForDataSharing",
    "subscriptionNoticeCount",
    "lastOnboardingVersion",
    "userID",
]
# Dialog/onboarding gates. Each of these, when present and "completed,"
# suppresses an otherwise-blocking first-run dialog. Listed explicitly
# rather than wildcarded so we don't accidentally smuggle in stateful
# host-only fields (project paths, GitHub paths, etc).
dialog_keys = [
    "hasCompletedOnboarding",
    "hasCompletedClaudeInChromeOnboarding",
    "claudeInChromeDefaultEnabled",
    "cachedChromeExtensionInstalled",
    "hasShownOpus45Notice",
    "hasShownOpus46Notice",
    "hasShownOpus47Notice",
    "effortCalloutV2Dismissed",
    "remoteDialogSeen",
    "remoteControlUpsellSeenCount",
    "lastReleaseNotesSeen",
    "hasOpusPlanDefault",
    "hasResetAutoModeOptInForDefaultOffer",
    "hasVisitedPasses",
    "passesUpsellSeenCount",
    "opus47LaunchSeenCount",
    "opus46FeedSeenCount",
    "opus45MigrationComplete",
    "opusProMigrationComplete",
    "sonnet1m45MigrationComplete",
    "sonnet45MigrationComplete",
    "thinkingMigrationComplete",
    "tipsHistory",
    "claudeCodeHints",
    "shiftEnterKeyBindingInstalled",
    "officialMarketplaceAutoInstallAttempted",
    "officialMarketplaceAutoInstalled",
]
out = {k: src[k] for k in (auth_keys + dialog_keys) if k in src}
if "oauthAccount" not in out:
    sys.exit(2)  # not logged in on host
os.umask(0o077)
with open(dst_path, "w") as f:
    json.dump(out, f)
os.chmod(dst_path, 0o600)
PY
}

cmd_auth() {
  local sub="${1:-ensure}"
  case "$sub" in
    ensure)
      if has_valid_claude_token; then
        echo "claude oauth token: ok ($CLAUDE_TOKEN_FILE)"
        return 0
      fi
      # Fast path: the host already has a Claude Code keychain credential
      # (from any prior `claude setup-token` or interactive login). Use it
      # without re-running the browser flow.
      local token
      if token="$(read_claude_token_from_keychain)"; then
        save_claude_token "$token"
        save_claude_credentials_blob || true
        echo "saved token from keychain -> $CLAUDE_TOKEN_FILE"
        [[ -f "$CLAUDE_CREDS_FILE" ]] && echo "saved full keychain blob -> $CLAUDE_CREDS_FILE"
        return 0
      fi
      command -v claude >/dev/null || {
        echo "error: 'claude' CLI not found on host — install Claude Code first" >&2
        echo "  curl -fsSL https://claude.ai/install.sh | bash" >&2
        exit 2
      }
      echo "==> running 'claude setup-token' — follow the browser flow"
      claude setup-token
      local rc=$?
      if (( rc != 0 )); then
        echo "error: 'claude setup-token' exited $rc" >&2
        exit "$rc"
      fi
      # `claude setup-token` writes the credential into the macOS keychain
      # (service: "Claude Code-credentials"); read it back from there.
      if ! token="$(read_claude_token_from_keychain)"; then
        echo "error: setup-token completed but no sk-ant-oat... token found" >&2
        echo "       in keychain entry 'Claude Code-credentials'." >&2
        exit 1
      fi
      save_claude_token "$token"
      save_claude_credentials_blob || true
      echo "saved token -> $CLAUDE_TOKEN_FILE"
      [[ -f "$CLAUDE_CREDS_FILE" ]] && echo "saved full keychain blob -> $CLAUDE_CREDS_FILE"
      ;;
    show)
      [[ -f "$CLAUDE_TOKEN_FILE" ]] || { echo "no token saved" >&2; exit 1; }
      cat "$CLAUDE_TOKEN_FILE"
      ;;
    path)
      echo "$CLAUDE_TOKEN_FILE"
      ;;
    clear|rm)
      rm -f "$CLAUDE_TOKEN_FILE" "$CLAUDE_CREDS_FILE"
      echo "cleared $CLAUDE_TOKEN_FILE"
      ;;
    *)
      echo "usage: cont auth [ensure|show|path|clear]" >&2
      exit 2
      ;;
  esac
}

cmd_pull() {
  local img="${1:-$UPSTREAM_BASE}"
  echo "pulling $img ..."
  tart pull "$img"
  echo "ok. configured base is: $(current_base)"
}

cmd_base() {
  if [[ -z "${1:-}" ]]; then
    echo "$(current_base)"
    return
  fi
  echo "$1" > "$BASE_FILE"
  echo "base image set to: $1"
}

cmd_list() {
  tart list
}

ensure_clone() {
  local name="$1" base; base="$(current_base)"
  if ! vm_exists "$name"; then
    echo "cloning $base -> $name ..."
    tart clone "$base" "$name"
  fi
  apply_spec "$name"
}

cmd_up() {
  require_name "${1:-}"
  local name="$1"
  ensure_clone "$name"
  if vm_running "$name"; then
    echo "$name already running"; return
  fi
  local log="/tmp/cont-$name.log"
  echo "booting $name (headless) ..."
  nohup tart run --no-graphics "$name" </dev/null >"$log" 2>&1 &
  local pid=$!
  disown "$pid" 2>/dev/null || true
  # Wait until the VM registers as running, OR tart exits (boot failure —
  # e.g. "VMs exceed the system limit" when 2+ other VMs are already up).
  for _ in $(seq 1 30); do
    if vm_running "$name"; then
      echo "started. log: $log"
      return
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      echo "error: tart run exited before $name reached running state." >&2
      echo "--- last lines of $log ---" >&2
      tail -10 "$log" >&2
      echo "--- running VMs (system cap is typically 2) ---" >&2
      tart list 2>&1 | awk 'NR==1 || $NF=="running"' >&2
      exit 1
    fi
    sleep 1
  done
  echo "error: $name didn't reach running state within 30s." >&2
  echo "--- last lines of $log ---" >&2
  tail -10 "$log" >&2
  exit 1
}

cmd_open() {
  require_name "${1:-}"
  local name="$1"
  ensure_clone "$name"
  if vm_running "$name"; then
    echo "$name already running — stopping so it can be re-opened with a window"
    tart stop "$name" >/dev/null 2>&1 || true
    sleep 2
  fi
  local log="/tmp/cont-$name.log"
  : > "$log"
  echo "starting $name with VNC ..."
  nohup tart run --vnc-experimental "$name" </dev/null >"$log" 2>&1 &
  disown || true
  # wait for tart to print the vnc:// URL (tart already calls `open` on it,
  # but we re-`open` to be sure Screen Sharing.app comes to the front)
  for _ in $(seq 1 30); do
    if grep -q "vnc://" "$log"; then
      local url; url="$(grep -oE 'vnc://[^[:space:]]+' "$log" | head -1 | sed 's/\.\.\.$//')"
      echo "opening $url in Screen Sharing"
      open "$url"
      return
    fi
    sleep 1
  done
  echo "warning: tart didn't print a vnc URL within 30s — see $log"
  return 1
}

cmd_down() {
  require_name "${1:-}"
  tart stop "$1"
}

cmd_rm() {
  require_name "${1:-}"
  if vm_running "$1"; then tart stop "$1" || true; fi
  tart delete "$1"
}

cmd_reset() {
  require_name "${1:-}"
  local name="$1"
  if vm_exists "$name"; then cmd_rm "$name"; fi
  cmd_up "$name"
}

cmd_snapshot() {
  require_name "${1:-}"
  require_name "${2:-}"
  local from="$1" to="$2"
  if vm_running "$from"; then
    echo "stopping $from before snapshot ..."
    tart stop "$from"
  fi
  tart clone "$from" "$to"
  echo "snapshotted $from -> $to"
}

cmd_clone() {
  cmd_snapshot "$@"
}

cmd_ip() {
  require_name "${1:-}"
  tart ip "$1"
}

cmd_ssh() {
  require_name "${1:-}"
  local name="$1"; shift || true
  ensure_sshpass
  local ip; ip="$(tart ip "$name" --wait 30)"
  sshpass -p "$SSH_PASS" ssh \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    -o LogLevel=ERROR \
    -o PreferredAuthentications=password \
    -o PubkeyAuthentication=no \
    "$SSH_USER@$ip" "$@"
}

# Boot the VM if needed, scp a script in, and run it. Default script is
# $SCRIPT_DIR/provision.sh; pass an explicit path to override.
cmd_provision() {
  require_name "${1:-}"
  local name="$1" script
  script="${2:-$SCRIPT_DIR/provision.sh}"
  if [[ ! -f "$script" ]]; then
    echo "error: no provision script at $script" >&2; exit 2
  fi

  if ! vm_running "$name"; then
    cmd_up "$name"
  fi

  ensure_sshpass
  local ip; ip="$(tart ip "$name" --wait 60)"

  # Fresh-VM ssh isn't actually ready the moment the VM reports running:
  # launchd is still bringing sshd up, so the first scp races and dies
  # with "Connection closed by remote host". Settle, then probe until
  # ssh actually answers before any scp. Same pattern as bake-agent-gold.sh.
  # Let sshd fully settle before we touch it. Every SSH connection counts
  # against macOS's rate limiter, so no separate probe — go straight into
  # the tar transfer with retries.
  echo "==> waiting 10s for $name ($ip) sshd to settle ..."
  sleep 10

  # ── SSH helpers (plain sshpass, no multiplexing) ────────────────────
  # sshpass + ControlMaster doesn't work (sshpass can't handle -fN).
  # Instead we use tar|ssh for directories (single connection per dir)
  # to avoid the scp -r connection-exhaustion that caused 148 failures.
  local -a ssh_opts=(
    -o StrictHostKeyChecking=no
    -o UserKnownHostsFile=/dev/null
    -o LogLevel=ERROR
    -o PreferredAuthentications=password
    -o PubkeyAuthentication=no
  )
  _vssh() { sshpass -p "$SSH_PASS" ssh "${ssh_opts[@]}" "$SSH_USER@$ip" "$@"; }
  _vscp() {
    local src="$1" dst="$2"
    sshpass -p "$SSH_PASS" scp "${ssh_opts[@]}" "$src" "$SSH_USER@$ip:$dst"
  }
  # tar|ssh: pack locally, stream over one SSH connection, unpack remotely.
  # Replaces scp -r which opened per-file connections and got rate-limited.
  _vtar() {
    local src_dir="$1" dst_dir="$2"
    tar cf - -C "$(dirname "$src_dir")" "$(basename "$src_dir")" \
      | sshpass -p "$SSH_PASS" ssh "${ssh_opts[@]}" "$SSH_USER@$ip" \
          "rm -rf '$dst_dir' && mkdir -p '$(dirname "$dst_dir")' && cd '$(dirname "$dst_dir")' && tar xf -"
  }

  # ── Bundle EVERYTHING into one tar stream over one SSH connection ────
  # Old approach: 15+ individual scp calls + scp -r for dirs = 20+ SSH
  # handshakes. macOS sshd rate-limits after ~10-15 rapid connections.
  # Fix: collect all files into a staging dir, tar|ssh the lot in ONE go.
  local script_dir; script_dir="$(cd "$(dirname "$script")" && pwd)"
  local script_name; script_name="$(basename "$script")"
  local stage; stage="$(mktemp -d)"
  trap "rm -rf '$stage'" RETURN

  # Individual files → flat in staging dir
  local seen_files=" "
  local f fname
  for f in "$script" "$script_dir"/provision*.sh "$script_dir"/.env* "$script_dir"/*.prompt.md; do
    [[ -f "$f" ]] || continue
    case "$f" in *.example|*.sample) continue ;; esac
    fname="$(basename "$f")"
    case "$seen_files" in *" $fname "*) continue ;; esac
    seen_files+="$fname "
    cp "$f" "$stage/$fname"
  done

  # Directories → preserve structure in staging dir
  local d
  for d in scripts skills; do
    [[ -d "$script_dir/$d" ]] || continue
    cp -a "$script_dir/$d" "$stage/$d"
  done

  # Claude credentials → renamed in staging dir
  if [[ -f "$CLAUDE_TOKEN_FILE" || -f "$CLAUDE_CREDS_FILE" ]]; then
    save_claude_credentials_blob >/dev/null 2>&1 || true
    save_claude_account_blob >/dev/null 2>&1 || true
    local fresh
    if fresh="$(read_claude_token_from_keychain 2>/dev/null)"; then
      save_claude_token "$fresh"
    fi
  fi
  [[ -f "$CLAUDE_TOKEN_FILE" ]]   && cp "$CLAUDE_TOKEN_FILE"   "$stage/cont-claude-token"
  [[ -f "$CLAUDE_CREDS_FILE" ]]   && cp "$CLAUDE_CREDS_FILE"   "$stage/cont-claude-credentials.json"
  [[ -f "$CLAUDE_ACCOUNT_FILE" ]] && cp "$CLAUDE_ACCOUNT_FILE" "$stage/cont-claude-account.json"

  # Ship it — ONE ssh connection, ONE tar stream, with retry
  local _nfiles; _nfiles="$(find "$stage" -type f | wc -l | tr -d ' ')"
  local _ndirs;  _ndirs="$(find "$stage" -type d -mindepth 1 | wc -l | tr -d ' ')"
  local _attempt
  for _attempt in 1 2 3; do
    echo "==> syncing ${_nfiles} files + ${_ndirs} dirs to $name:/tmp/ (attempt ${_attempt}/3) ..."
    if tar cf - -C "$stage" . \
      | sshpass -p "$SSH_PASS" ssh "${ssh_opts[@]}" "$SSH_USER@$ip" \
          "cd /tmp && tar xf - --no-same-owner 2>/dev/null; true"; then
      break
    fi
    echo "    transfer failed, waiting 5s before retry ..."
    sleep 5
  done

  local fast_env=""
  if [[ "${CONT_PROVISION_FAST:-}" == "1" ]]; then
    fast_env="CONT_PROVISION_FAST=1 "
  fi
  # Forward the per-agent env filename so one provisioner can serve
  # multiple instances of the same agent type (auditor vs auditor2).
  if [[ -n "${AGENT_ENV_FILE:-}" ]]; then
    fast_env="${fast_env}AGENT_ENV_FILE='${AGENT_ENV_FILE}' "
  fi

  echo "==> running ${fast_env}$script_name in $name ..."
  _vssh "${fast_env}bash /tmp/$script_name && sync && sync"
}

# Sync — re-run the per-agent provisioner in FAST mode. Used after cloning
# a per-agent gold image, when only the volatile per-job state (scripts,
# skills, env, prompt, Claude OAuth) needs refreshing. Same arguments as
# `cont provision`. ~5–10s vs ~30–60s for a full provision.
cmd_sync() {
  CONT_PROVISION_FAST=1 cmd_provision "$@"
}

cmd_spec() {
  require_name "${1:-}"
  local name="$1" file; file="$(spec_file "$name")"
  shift
  if (( $# == 0 )); then
    echo "# spec: $file"
    if [[ -f "$file" ]]; then cat "$file"; else echo "(none — VM uses tart defaults)"; fi
    if vm_exists "$name"; then
      echo
      echo "# live config from tart get:"
      tart get "$name"
    fi
    return
  fi
  if [[ "$1" == "edit" ]]; then
    : > /dev/null
    "${EDITOR:-vi}" "$file"
    return
  fi
  if [[ "$1" == "clear" ]]; then
    rm -f "$file"; echo "removed $file"; return
  fi
  # k=v pairs: write/replace each in the spec file
  for kv in "$@"; do
    [[ "$kv" == *=* ]] || { echo "expected key=value, got: $kv" >&2; exit 2; }
    local k="${kv%%=*}" v="${kv#*=}"
    case "$k" in
      cpu|memory|display|disk) ;;
      *) echo "unknown key '$k' (allowed: cpu memory display disk)" >&2; exit 2 ;;
    esac
    touch "$file"
    if grep -qE "^[[:space:]]*$k[[:space:]]*=" "$file"; then
      # macOS sed needs an empty backup arg
      sed -i '' -E "s|^[[:space:]]*$k[[:space:]]*=.*|$k=$v|" "$file"
    else
      printf '%s=%s\n' "$k" "$v" >> "$file"
    fi
  done
  echo "spec updated: $file"
  if vm_exists "$name" && ! vm_running "$name"; then apply_spec "$name"; fi
}

cmd_status() {
  echo "configured base: $(current_base)"
  echo
  tart list
}

usage() {
  cat <<'EOF'
cont — programmatic macOS-on-macOS environments via tart

  cont pull [image]           pull base image (default: cirruslabs tahoe)
  cont base [image]           show or set the base image used for `up`
  cont auth [ensure|show|path|clear]
                              ensure (default) runs `claude setup-token` if no
                              valid token saved; the token is auto-injected
                              into VMs by `cont provision`
  cont list                   list all VMs and their status
  cont status                 show base + list
  cont up <name>              clone base -> name (if missing) and boot
  cont down <name>            stop a VM
  cont reset <name>           delete and recreate from base
  cont rm <name>              delete a VM
  cont snapshot <from> <to>   APFS-clone a VM (also: `clone`)
  cont ip <name>              print VM IP
  cont ssh <name> [cmd...]    ssh in (admin/admin)
  cont open <name>            boot if needed and bring GUI window to front
  cont provision <name> [s]   boot if needed, scp script in, run it (default: ./provision.sh)
  cont sync <name> [s]        same as provision but FAST=1 (skip Tier-2 installs;
                              expects per-agent gold image to already have them)
  cont spec <name>            show spec + live config
  cont spec <name> k=v ...    set keys (cpu memory display disk); applies if stopped
  cont spec <name> edit       open spec file in $EDITOR
  cont spec <name> clear      remove the spec file
EOF
}

main() {
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    pull)     cmd_pull "$@" ;;
    base)     cmd_base "$@" ;;
    auth)     cmd_auth "$@" ;;
    list|ls)  cmd_list ;;
    status)   cmd_status ;;
    up|start) cmd_up "$@" ;;
    down|stop)cmd_down "$@" ;;
    reset)    cmd_reset "$@" ;;
    rm|delete)cmd_rm "$@" ;;
    snapshot|clone) cmd_snapshot "$@" ;;
    ip)       cmd_ip "$@" ;;
    ssh|shell)cmd_ssh "$@" ;;
    open|gui) cmd_open "$@" ;;
    provision)cmd_provision "$@" ;;
    sync)     cmd_sync "$@" ;;
    spec)     cmd_spec "$@" ;;
    ""|-h|--help|help) usage ;;
    *) echo "unknown: $cmd" >&2; usage; exit 2 ;;
  esac
}

main "$@"
