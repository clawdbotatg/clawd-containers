#!/usr/bin/env bash
# cont — a thin wrapper around `tart` for macOS-on-macOS isolated environments.
#
# Workflow:
#   cont pull               # fetch the upstream base image (one-time, ~30GB)
#   cont up dev             # clone base -> "dev" and boot it
#   cont ssh dev            # admin/admin
#   cont snapshot dev gold  # APFS-clone "dev" into "gold" as your golden image
#   cont base gold          # tell cont to clone from "gold" going forward
#   cont reset dev          # nuke "dev" and reclone fresh from the configured base
#   cont down dev           # stop
#   cont rm dev             # delete

set -euo pipefail

# macOS ships no `timeout` (it's GNU coreutils). cmd_down guards the
# credential harvest with `timeout 45` — without a shim that call is
# "command not found" on every stop, so the rotated Claude credential is
# never harvested back out of the VM and the login dies with it. Same
# shim agent-wrangler.sh carries, for the same reason.
if ! command -v timeout >/dev/null 2>&1; then
  timeout() {
    python3 - "$@" <<'PY'
import subprocess, sys
try:
    sys.exit(subprocess.run(sys.argv[2:], timeout=float(sys.argv[1])).returncode)
except subprocess.TimeoutExpired:
    sys.exit(124)
PY
  }
fi

# Resolve the directory this script lives in, following symlinks (so
# `./cont` and the /usr/local/bin/cont symlink both find provision.sh).
self="${BASH_SOURCE[0]}"
while [[ -L "$self" ]]; do
  link="$(readlink "$self")"
  if [[ "$link" = /* ]]; then self="$link"
  else self="$(cd "$(dirname "$self")" && pwd)/$(basename "$link")"
  fi
done
SCRIPT_DIR="$(cd "$(dirname "$self")" && pwd)"

UPSTREAM_BASE="ghcr.io/cirruslabs/macos-tahoe-base:latest"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/cont"
BASE_FILE="$CONFIG_DIR/base"
SPEC_DIR="$CONFIG_DIR/specs"
CLAUDE_TOKEN_FILE="$CONFIG_DIR/claude-token"
CLAUDE_CREDS_FILE="$CONFIG_DIR/claude-credentials.json"
CLAUDE_ACCOUNT_FILE="$CONFIG_DIR/claude-account.json"
CLAUDE_SRC_FILE="$CONFIG_DIR/claude-source"
VM_ACCOUNTS_DIR="$CONFIG_DIR/vm-accounts"
SSH_USER="admin"
SSH_PASS="admin"

mkdir -p "$CONFIG_DIR" "$SPEC_DIR" "$VM_ACCOUNTS_DIR"

spec_file() { echo "$SPEC_DIR/$1.conf"; }

# Read one key from a spec file. Lines look like `cpu=8`. Blank lines and
# `# comments` are ignored. Returns empty string if missing.
spec_get() {
  local file="$1" key="$2"
  [[ -f "$file" ]] || return 0
  awk -F= -v k="$key" '
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }
    {
      gsub(/[[:space:]]/, "", $1)
      if ($1 == k) {
        sub(/^[^=]*=/, "")
        sub(/^[[:space:]]+/, ""); sub(/[[:space:]]+$/, "")
        print; exit
      }
    }' "$file"
}

# Apply the spec file for $1 to the VM via `tart set`. VM must be stopped.
apply_spec() {
  local name="$1" file; file="$(spec_file "$name")"
  [[ -f "$file" ]] || return 0
  if vm_running "$name"; then
    echo "warning: $name is running — spec will apply on next stop/start" >&2
    return 0
  fi
  local cpu mem disp disk args=()
  cpu="$(spec_get "$file" cpu)"
  mem="$(spec_get "$file" memory)"
  disp="$(spec_get "$file" display)"
  disk="$(spec_get "$file" disk)"
  [[ -n "$cpu"  ]] && args+=(--cpu "$cpu")
  [[ -n "$mem"  ]] && args+=(--memory "$mem")
  [[ -n "$disp" ]] && args+=(--display "$disp")
  [[ -n "$disk" ]] && args+=(--disk-size "$disk")
  if (( ${#args[@]} > 0 )); then
    echo "applying spec $(basename "$file") -> $name: ${args[*]}"
    tart set "$name" "${args[@]}"
  fi
}

current_base() {
  if [[ -f "$BASE_FILE" ]]; then cat "$BASE_FILE"; else echo "$UPSTREAM_BASE"; fi
}

vm_exists() {
  # awk (not grep -q): under pipefail, grep -q's early exit SIGPIPEs tart
  # and the pipeline goes false even on a match (~73% false-negative rate).
  tart list --quiet --source local 2>/dev/null \
    | awk -v n="$1" '$0==n{f=1} END{exit !f}'
}

vm_running() {
  tart list 2>/dev/null \
    | awk -v n="$1" '$1=="local" && $2==n && $NF=="running" { f=1 } END { exit !f }'
}

require_name() {
  if [[ -z "${1:-}" ]]; then echo "error: VM name required" >&2; exit 2; fi
}

ensure_sshpass() {
  command -v sshpass >/dev/null || {
    echo "installing sshpass (needed for non-interactive ssh)..." >&2
    brew install esolitos/ipa/sshpass >/dev/null
  }
}

# ── Claude account selection ────────────────────────────────────────────
# Which Claude Code login the fleet ships into VMs. Default: the host's
# ~/.claude login (keychain service "Claude Code-credentials"). `cont
# account <name>` points it at a harness account dir instead
# (~/.clawd-accounts/<name>, whose CLAUDE_CONFIG_DIR-scoped keychain
# service is "Claude Code-credentials-<sha256(dir)[:8]>"). Every token
# read, refresh ping and blob-staging below follows the selection, so the
# fleet and the harness share ONE credential store per account. Never fork
# a store (copy a blob under a second service and let both refresh):
# OAuth refresh rotates the refresh token, and a copy that falls behind
# the rotation is dead forever (the ef/sub2 403s).
ACCOUNTS_DIR="$HOME/.clawd-accounts"

claude_src_dir() {  # print selected config dir; empty = default ~/.claude
  local d=""
  [[ -f "$CLAUDE_SRC_FILE" ]] && d="$(cat "$CLAUDE_SRC_FILE" 2>/dev/null || true)"
  printf '%s' "${d%/}"
}

claude_src_name() {  # human label for the selection
  local d; d="$(claude_src_dir)"
  if [[ -z "$d" ]]; then echo "default"
  elif [[ "$d" == "$ACCOUNTS_DIR"/* ]]; then basename "$d"
  else echo "$d"; fi
}

claude_keychain_service_for() {  # $1 = config dir ("" = default)
  local dir="${1%/}"
  if [[ -z "$dir" ]]; then printf 'Claude Code-credentials\n'; return 0; fi
  # Mirror Claude Code's own derivation exactly (see tools/usage_probe.py
  # in the harness repo): sha256 of the NFC-normalized dir path, first 8 hex.
  python3 -c 'import hashlib, sys, unicodedata
print("Claude Code-credentials-"
      + hashlib.sha256(unicodedata.normalize("NFC", sys.argv[1]).encode()).hexdigest()[:8])' "$dir"
}

claude_keychain_service() { claude_keychain_service_for "$(claude_src_dir)"; }

# Resolve the claude binary explicitly: under launchd the PATH is minimal and
# a bare `claude` fails, silently skipping refreshes (the 2026-07-14
# crash-loop; again 2026-08-04 when the install moved to /opt/homebrew/bin).
resolve_claude_bin() {
  local b
  b="$(command -v claude 2>/dev/null || true)"
  if [[ -z "$b" ]]; then
    for b in /opt/homebrew/bin/claude "$HOME/.local/bin/claude" "$HOME/.claude/local/claude"; do
      [[ -x "$b" ]] && break
      b=""
    done
  fi
  [[ -n "$b" ]] || return 1
  printf '%s\n' "$b"
}

# Is a claude process (anyone's — a harness session, a hand-launched
# terminal, another ping) running under this config dir right now? Such a
# process holds and lazily renews the account's rotating refresh grant; a
# second consumer replaying that grant trips OAuth reuse detection and
# revokes the whole token family (how sub3 died 2026-08-06). A claude with
# no CLAUDE_CONFIG_DIR in its env is on the default account.
claude_dir_live() {  # $1 = config dir ("" = default)
  local dir="${1%/}"
  ps axeww -o command= 2>/dev/null | python3 -c '
import os, re, sys
want = os.path.normpath(os.path.expanduser(sys.argv[1] or "~/.claude"))
for line in sys.stdin:
    line = line.strip()
    if os.path.basename(line.split(None, 1)[0] if line else "") != "claude":
        continue
    m = re.search(r"CLAUDE_CONFIG_DIR=(\S+)", line)
    d = os.path.normpath(os.path.expanduser((m.group(1) if m else "~/.claude").rstrip("/")))
    if d == want:
        sys.exit(0)
sys.exit(1)' "$dir"
}

# Run a command while holding an exclusive per-account refresh lock —
# the SAME lock file the harness poller takes (<config dir>/.refresh.lock)
# — so cont and the harness can never rotate one grant simultaneously.
# Blocks up to 90s for the lock, then gives up (exit 75).
locked_run() {  # $1 = lock file; rest = command
  python3 - "$@" <<'PY'
import fcntl, subprocess, sys, time
lf, cmd = sys.argv[1], sys.argv[2:]
f = open(lf, "w")
deadline = time.time() + 90
while True:
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        break
    except OSError:
        if time.time() > deadline:
            sys.exit(75)
        time.sleep(1)
sys.exit(subprocess.run(cmd, stdin=subprocess.DEVNULL).returncode)
PY
}

# Minimal `claude -p` under a given config dir so Claude Code itself
# refreshes-and-rewrites that account's keychain entry (never hand-roll the
# OAuth refresh: discarding the rotated refresh token kills the account).
# For the default account CLAUDE_CONFIG_DIR must be UNSET — shells on this
# host export it pointing at a harness account (2026-07-09 trap).
# Guards (both born of the sub3 postmortem, 2026-08-06): never ping while a
# live claude owns the grant, and hold the cross-process refresh lock for
# the ping's whole life so no other deliberate refresher can interleave.
claude_ping_dir() {  # $1 = config dir ("" = default)
  local dir="${1%/}"
  local claude_bin
  claude_bin="$(resolve_claude_bin)" || return 1
  if claude_dir_live "$dir"; then
    echo "ping skipped: a live claude process owns '${dir:-default}'" >&2
    return 1
  fi
  local lock="${dir:-$HOME/.claude}/.refresh.lock"
  # </dev/null via locked_run: claude -p reads stdin — without this it eats
  # the stdin of any while-read loop that calls us (the account roster bug).
  if [[ -z "$dir" ]]; then
    locked_run "$lock" timeout 60 env -u CLAUDE_CONFIG_DIR "$claude_bin" \
      -p --output-format text "reply with the single word OK" >/dev/null 2>&1
  else
    locked_run "$lock" env "CLAUDE_CONFIG_DIR=$dir" timeout 60 "$claude_bin" \
      -p --output-format text "reply with the single word OK" >/dev/null 2>&1
  fi
}

# Print an account's credential blob JSON ({"claudeAiOauth":{...}}).
# Keychain first (Claude Code's primary store on macOS), then the
# .credentials.json file inside the config dir — some logins only have
# the file. $1 = config dir ("" = default ~/.claude).
read_claude_blob_for() {
  local dir="${1%/}" json path
  if json="$(security find-generic-password -s "$(claude_keychain_service_for "$dir")" -w 2>/dev/null)" \
     && [[ -n "$json" ]]; then
    printf '%s' "$json"; return 0
  fi
  path="${dir:-$HOME/.claude}/.credentials.json"
  if [[ -f "$path" ]]; then cat "$path"; return 0; fi
  return 1
}

has_valid_claude_token() {
  [[ -f "$CLAUDE_TOKEN_FILE" ]] || return 1
  local t; t="$(tr -d '[:space:]' < "$CLAUDE_TOKEN_FILE" 2>/dev/null)"
  # Accept any sk-ant-oat... prefix (e.g. sk-ant-oat01_...).
  [[ "$t" == sk-ant-oat* ]] || return 1
  # If we have the keychain blob, also gate on expiresAt — a file on disk
  # with the right prefix tells us nothing about whether the access token
  # is still live, and stale tokens shipped to a VM fail with 401.
  [[ -f "$CLAUDE_CREDS_FILE" ]] || return 0
  python3 - "$CLAUDE_CREDS_FILE" <<'PY' >/dev/null 2>&1 || return 1
import json, sys, time
d = json.load(open(sys.argv[1]))
exp = d.get("claudeAiOauth", {}).get("expiresAt", 0)
sys.exit(0 if exp and exp/1000 > time.time() else 1)
PY
}

# Pull the OAuth token from the SELECTED account's keychain entry (see
# claude_src_dir). Returns 0 and prints the token on stdout if a
# well-formed sk-ant-oat-... value is present, else returns 1.
read_claude_token_from_keychain() {
  local json token
  json="$(read_claude_blob_for "$(claude_src_dir)")" || return 1
  [[ -n "$json" ]] || return 1
  token="$(printf '%s' "$json" | python3 -c \
    'import json,sys
try:
  d=json.load(sys.stdin)
  t=d.get("claudeAiOauth",{}).get("accessToken","")
  print(t if t.startswith("sk-ant-oat") else "")
except Exception:
  pass' 2>/dev/null)"
  [[ -n "$token" ]] || return 1
  printf '%s\n' "$token"
}

save_claude_token() {
  local token="$1"
  ( umask 077; printf '%s\n' "$token" > "$CLAUDE_TOKEN_FILE" )
  chmod 600 "$CLAUDE_TOKEN_FILE"
}

# Trigger Claude Code's internal keychain refresh on the host so the access
# token in "Claude Code-credentials" is rotated to a fresh one. Access
# tokens expire in ~hours; the refreshToken is long-lived.
#
# Two traps (2026-07-09, fleet down 28h on this):
#   1. The refresh must run under the SELECTED account's config dir (unset
#      for default) — a refresh under the wrong CLAUDE_CONFIG_DIR rotates
#      the wrong credential and leaves the shipped blob stale forever.
#   2. `claude --version` does not reliably rotate the token; a real -p
#      call does. Only pay that cost when the token is actually near expiry.
refresh_host_claude_keychain() {
  local claude_bin
  claude_bin="$(resolve_claude_bin)" || return 0
  local left
  left="$(read_claude_blob_for "$(claude_src_dir)" 2>/dev/null \
    | python3 -c 'import json,sys,time
try:
    o=json.load(sys.stdin)["claudeAiOauth"]
    print(int(o.get("expiresAt",0)/1000 - time.time()))
except Exception:
    pass' 2>/dev/null)"
  # Plenty of life left: nothing to do. Threshold defaults to 1h — several
  # orgs now mint ~1h access tokens while VM jobs run up to 4h, so ship
  # the freshest token we can get (an in-guest refresh mid-job rotates
  # the refresh token; custody/harvest recovers that, but a fresh token
  # at boot pushes the first rotation as late as possible).
  [[ -n "$left" ]] && (( left > ${CONT_REFRESH_MIN_LEFT:-3600} )) && return 0
  claude_ping_dir "$(claude_src_dir)" || true
}

# Save the full keychain credential blob so the VM can re-create an
# identical keychain entry. Just the access token isn't enough — Claude
# Code's interactive UI on macOS reads from the keychain entry
# "Claude Code-credentials", which is a JSON object with refreshToken,
# scopes, etc. Refresh first so we ship a non-expired access token.
save_claude_credentials_blob() {
  refresh_host_claude_keychain
  local json
  json="$(read_claude_blob_for "$(claude_src_dir)")" || return 1
  [[ -n "$json" ]] || return 1
  ( umask 077; printf '%s' "$json" > "$CLAUDE_CREDS_FILE" )
  chmod 600 "$CLAUDE_CREDS_FILE"
}

# Extract the auth/onboarding-state fields from the host's ~/.claude.json.
# Claude Code's interactive UI gates "logged in?" on the presence of
# `oauthAccount` (and friends) in this file — even when the keychain
# entry exists. Without this, fresh VMs always show the login picker.
# We deliberately copy ONLY auth-state keys: project paths, history,
# repo paths, and other personal/host-specific state stay on the host.
save_claude_account_blob() {
  # The selected account's .claude.json lives inside its config dir
  # (CLAUDE_CONFIG_DIR layout); the default account's at ~/.claude.json.
  local src="$HOME/.claude.json" dir; dir="$(claude_src_dir)"
  [[ -n "$dir" ]] && src="$dir/.claude.json"
  [[ -f "$src" ]] || return 1
  python3 - "$src" "$CLAUDE_ACCOUNT_FILE" <<'PY' || return 1
import json, os, sys
src_path, dst_path = sys.argv[1], sys.argv[2]
src = json.load(open(src_path))
# Auth / "is logged in?" gate.
auth_keys = [
    "oauthAccount",
    "hasAvailableSubscription",
    "claudeCodeFirstTokenDate",
    "isQualifiedForDataSharing",
    "subscriptionNoticeCount",
    "lastOnboardingVersion",
    "userID",
]
# Dialog/onboarding gates. Each of these, when present and "completed,"
# suppresses an otherwise-blocking first-run dialog. Listed explicitly
# rather than wildcarded so we don't accidentally smuggle in stateful
# host-only fields (project paths, GitHub paths, etc).
dialog_keys = [
    "hasCompletedOnboarding",
    "hasCompletedClaudeInChromeOnboarding",
    "claudeInChromeDefaultEnabled",
    "cachedChromeExtensionInstalled",
    "hasShownOpus45Notice",
    "hasShownOpus46Notice",
    "hasShownOpus47Notice",
    "effortCalloutV2Dismissed",
    "remoteDialogSeen",
    "remoteControlUpsellSeenCount",
    "lastReleaseNotesSeen",
    "hasOpusPlanDefault",
    "hasResetAutoModeOptInForDefaultOffer",
    "hasVisitedPasses",
    "passesUpsellSeenCount",
    "opus47LaunchSeenCount",
    "opus46FeedSeenCount",
    "opus45MigrationComplete",
    "opusProMigrationComplete",
    "sonnet1m45MigrationComplete",
    "sonnet45MigrationComplete",
    "thinkingMigrationComplete",
    "tipsHistory",
    "claudeCodeHints",
    "shiftEnterKeyBindingInstalled",
    "officialMarketplaceAutoInstallAttempted",
    "officialMarketplaceAutoInstalled",
]
out = {k: src[k] for k in (auth_keys + dialog_keys) if k in src}
if "oauthAccount" not in out:
    sys.exit(2)  # not logged in on host
os.umask(0o077)
with open(dst_path, "w") as f:
    json.dump(out, f)
os.chmod(dst_path, 0o600)
PY
}

cmd_auth() {
  local sub="${1:-ensure}"
  case "$sub" in
    ensure)
      if has_valid_claude_token; then
        echo "claude oauth token: ok ($CLAUDE_TOKEN_FILE)"
        return 0
      fi
      # Fast path: the host already has a Claude Code keychain credential
      # (from any prior `claude setup-token` or interactive login). Use it
      # without re-running the browser flow.
      local token
      if token="$(read_claude_token_from_keychain)"; then
        save_claude_token "$token"
        save_claude_credentials_blob || true
        echo "saved token from keychain -> $CLAUDE_TOKEN_FILE"
        [[ -f "$CLAUDE_CREDS_FILE" ]] && echo "saved full keychain blob -> $CLAUDE_CREDS_FILE"
        return 0
      fi
      local claude_bin
      claude_bin="$(resolve_claude_bin)" || {
        echo "error: 'claude' CLI not found on host — install Claude Code first" >&2
        echo "  curl -fsSL https://claude.ai/install.sh | bash" >&2
        exit 2
      }
      echo "==> running 'claude setup-token' — follow the browser flow"
      "$claude_bin" setup-token
      local rc=$?
      if (( rc != 0 )); then
        echo "error: 'claude setup-token' exited $rc" >&2
        exit "$rc"
      fi
      # `claude setup-token` writes the credential into the macOS keychain
      # (service: "Claude Code-credentials"); read it back from there.
      if ! token="$(read_claude_token_from_keychain)"; then
        echo "error: setup-token completed but no sk-ant-oat... token found" >&2
        echo "       in keychain entry 'Claude Code-credentials'." >&2
        exit 1
      fi
      save_claude_token "$token"
      save_claude_credentials_blob || true
      echo "saved token -> $CLAUDE_TOKEN_FILE"
      [[ -f "$CLAUDE_CREDS_FILE" ]] && echo "saved full keychain blob -> $CLAUDE_CREDS_FILE"
      ;;
    show)
      [[ -f "$CLAUDE_TOKEN_FILE" ]] || { echo "no token saved" >&2; exit 1; }
      cat "$CLAUDE_TOKEN_FILE"
      ;;
    path)
      echo "$CLAUDE_TOKEN_FILE"
      ;;
    clear|rm)
      rm -f "$CLAUDE_TOKEN_FILE" "$CLAUDE_CREDS_FILE"
      echo "cleared $CLAUDE_TOKEN_FILE"
      ;;
    *)
      echo "usage: cont auth [ensure|show|path|clear]" >&2
      exit 2
      ;;
  esac
}

# ── cont account — select which Claude login the fleet ships ────────────
# Usage headroom for one account. $1 = config dir ("" = default). Prints
# "<headroom> <resets_at-of-worst-window>". Exit 3 = access token expired
# (caller may refresh via claude_ping_dir and retry); other nonzero = no
# usable credential / endpoint failure.
account_headroom() {
  local dir="${1%/}" blob
  blob="$(read_claude_blob_for "$dir")" || return 1
  [[ -n "$blob" ]] || return 1
  printf '%s' "$blob" | python3 -c '
import json, sys, time, urllib.error, urllib.request
try:
    o = json.load(sys.stdin)["claudeAiOauth"]
    tok = o.get("accessToken", "")
    if not tok or o.get("expiresAt", 0) / 1000 < time.time() + 60:
        sys.exit(3)  # expired; a claude ping under this dir will rotate it
    req = urllib.request.Request(
        "https://api.anthropic.com/api/oauth/usage",
        headers={"Authorization": "Bearer " + tok,
                 "anthropic-beta": "oauth-2025-04-20",
                 "Content-Type": "application/json"})
    u = json.load(urllib.request.urlopen(req, timeout=10))
    worst = [0.0, ""]
    def see(pct, resets):
        if pct > worst[0]:
            worst[0], worst[1] = pct, resets or ""
    for k in ("five_hour", "seven_day", "seven_day_opus", "seven_day_sonnet"):
        w = u.get(k)
        if isinstance(w, dict) and isinstance(w.get("utilization"), (int, float)):
            see(float(w["utilization"]), w.get("resets_at"))
    # model-scoped caps (e.g. a Fable weekly limit) live only in `limits`
    for lim in u.get("limits") or []:
        if isinstance(lim, dict) and isinstance(lim.get("percent"), (int, float)):
            see(float(lim["percent"]), lim.get("resets_at"))
    print(f"{100 - worst[0]:.1f} {worst[1]}")
except SystemExit:
    raise
except urllib.error.HTTPError as e:
    sys.exit(4 if e.code == 429 else 1)  # 4 = rate-limited, NOT a dead login
except Exception:
    sys.exit(1)
'
}

account_headroom_fresh() {  # account_headroom + one refresh-and-retry
  local dir="${1%/}" out rc
  out="$(account_headroom "$dir")"; rc=$?
  if (( rc == 3 )); then
    claude_ping_dir "$dir" || true
    out="$(account_headroom "$dir")"; rc=$?
  fi
  # Propagate the code — 4 (endpoint rate-limited) must stay
  # distinguishable from "no usable credential" for account_auto.
  (( rc == 0 )) || return $rc
  printf '%s\n' "$out"
}

# Subscription pool identity for a login dir. One email can hold seats in
# several orgs and one org can be bound into several dirs — the ORG is the
# usage pool, not the dir (2026-08-18: default+sub3 are one sub,
# austinmax/ef/sub2 another; "hopping" between sibling dirs changes
# nothing). $1 = config dir ("" = default, whose config is ~/.claude.json).
# Prints "org_uuid<TAB>org_name"; fails if no account is bound.
account_org() {
  local dir="${1%/}" cfg
  if [[ -z "$dir" ]]; then cfg="$HOME/.claude.json"; else cfg="$dir/.claude.json"; fi
  [[ -f "$cfg" ]] || return 1
  python3 -c '
import json, sys
try:
    a = json.load(open(sys.argv[1])).get("oauthAccount") or {}
    u, n = a.get("organizationUuid", ""), a.get("organizationName", "")
    if not (u or n):
        sys.exit(1)
    print((u or n) + "\t" + (n or u))
except SystemExit:
    raise
except Exception:
    sys.exit(1)
' "$cfg"
}

account_roster() {  # candidate config dirs, one per line ("-" = default)
  echo "-"
  local d
  for d in "$ACCOUNTS_DIR"/*/; do
    [[ -d "$d" ]] || continue
    echo "${d%/}"
  done
}

# ── Credential custody ──────────────────────────────────────────────────
# A VM that ships with a login's credential blob will REFRESH it in-guest
# once the access token expires mid-job, and OAuth refresh ROTATES the
# refresh token — from that moment the host's copy is a stale sibling,
# the next host-side refresh gets rejected, and claude wipes the blob:
# the login reads "dead" (that killed the clawd login, 2026-08-04; access
# tokens on several orgs now live ~1h while jobs run up to 4h, so
# in-guest rotation is the NORM, not the edge case). Custody closes both
# directions: cmd_provision records which login each VM shipped with
# (vm-accounts/<vm>), every host-side refresh path skips a login while a
# running VM holds it, and cmd_down harvests the VM's (possibly rotated)
# blob back into the host store before stopping.

_RUNNING_VMS_MEMO="__unset__"
running_vms() {  # one VM name per line; memoized per cont invocation
  if [[ "$_RUNNING_VMS_MEMO" == "__unset__" ]]; then
    _RUNNING_VMS_MEMO="$(tart list 2>/dev/null \
      | awk '$1=="local" && $NF=="running" {print $2}')"
  fi
  [[ -n "$_RUNNING_VMS_MEMO" ]] && printf '%s\n' "$_RUNNING_VMS_MEMO"
  return 0
}

custody_release() { rm -f "$VM_ACCOUNTS_DIR/${1:?}"; }

account_in_custody() {  # $1 = config dir ("" = default); 0 iff a RUNNING vm holds it
  local d="${1%/}" f vm rec
  for f in "$VM_ACCOUNTS_DIR"/*; do
    [[ -f "$f" ]] || continue
    rec="$(cat "$f" 2>/dev/null || true)"
    [[ "${rec%/}" == "$d" ]] || continue
    vm="$(basename "$f")"
    if running_vms | awk -v n="$vm" '$0==n{f=1} END{exit !f}'; then
      return 0
    fi
  done
  return 1
}

custody_vm_for() {  # $1 = config dir; prints the VM name(s) holding a custody record for it
  local d="${1%/}" f rec
  for f in "$VM_ACCOUNTS_DIR"/*; do
    [[ -f "$f" ]] || continue
    rec="$(cat "$f" 2>/dev/null || true)"
    [[ "${rec%/}" == "$d" ]] && basename "$f"
  done
  return 0
}

# Pull a VM's Claude credential blob back into the host store. Call while
# the VM is still running (cmd_down does). If the in-guest blob is newer
# (higher expiresAt ⇒ the guest refreshed, i.e. rotated), adopt it:
# update the host keychain entry in place (-U preserves the ACL claude
# set on its own item) and mirror to <dir>/.credentials.json, which
# read_claude_blob_for and claude both fall back to.
grab_vm_blob() {  # $1 = vm name; prints the guest's credential blob.
  # rc 0 = blob read; rc 2 = ssh OK but the guest POSITIVELY has no
  # credential (keychain answered absent + no file — e.g. the guest's
  # claude wiped it after a rejected refresh); rc 1 = couldn't reach the
  # guest (unknown — treat as "may still hold the lineage tip"). The
  # sentinel is what separates 2 from 1: without it, a wiped guest looked
  # identical to a dead ssh and reclaim STRANDED the login forever
  # (austinmax/auditor loop, 2026-08-07).
  local ip out; ip="$(tart ip "$1" 2>/dev/null || true)"
  [[ -n "$ip" ]] || return 1
  # ServerAlive + outer timeout: ConnectTimeout only covers the TCP
  # connect — a guest that halts mid-session (auditor agents self-halt)
  # otherwise leaves this ssh hung forever, wedging reclaim/keepalive.
  # -n: stdin from /dev/null. Without it, the FIRST successful in-loop grab
  # slurps the caller's stdin — keepalive's roster while-read died right
  # after the first connected reclaim (2026-08-07), silently skipping every
  # login after it. Same class as the "claude -p eats stdin" trap.
  out="$(timeout 25 sshpass -p "$SSH_PASS" ssh -n \
      -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
      -o LogLevel=ERROR -o ConnectTimeout=8 \
      -o ServerAliveInterval=5 -o ServerAliveCountMax=2 "$SSH_USER@$ip" \
      'security unlock-keychain -p admin "$HOME/Library/Keychains/login.keychain-db" 2>/dev/null;
       echo __CONT_SSH_OK__;
       security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null \
         || cat "$HOME/.claude/.credentials.json" 2>/dev/null' \
      2>/dev/null)" || true
  [[ "$out" == *__CONT_SSH_OK__* ]] || return 1
  out="${out#*__CONT_SSH_OK__}"
  out="${out#$'\n'}"
  [[ -n "$out" ]] || return 2
  printf '%s' "$out"
}

# Adopt a guest blob into the host store for a config dir, iff it is newer
# (higher expiresAt ⇒ the guest refreshed, i.e. rotated the lineage tip).
# $1 = config dir ("" = default), $2 = blob JSON, $3 = label for messages.
# Returns 0 adopted / 0 not-newer (both fine) / 1 malformed blob.
adopt_blob_for() {
  local dir="${1%/}" blob="$2" label="${3:-vm}" vm_exp host_exp
  vm_exp="$(printf '%s' "$blob" | python3 -c '
import json,sys
try:
    o=json.load(sys.stdin)["claudeAiOauth"]
    assert o.get("accessToken") and o.get("refreshToken")
    print(int(o.get("expiresAt",0)))
except Exception:
    pass' 2>/dev/null)"
  if [[ -z "$vm_exp" ]]; then
    echo "harvest: $label blob malformed or missing refreshToken — skipping"; return 1
  fi
  host_exp="$(read_claude_blob_for "$dir" 2>/dev/null | python3 -c '
import json,sys
try:
    print(int(json.load(sys.stdin)["claudeAiOauth"].get("expiresAt",0)))
except Exception:
    print(0)' 2>/dev/null)"
  host_exp="${host_exp:-0}"
  if (( vm_exp <= host_exp )); then
    echo "harvest: $label blob not newer than host (${vm_exp} <= ${host_exp}) — nothing to adopt"
    return 0
  fi
  local svc acct path
  svc="$(claude_keychain_service_for "$dir")"
  path="${dir:-$HOME/.claude}/.credentials.json"
  ( umask 077; printf '%s' "$blob" > "$path" )
  if security find-generic-password -s "$svc" >/dev/null 2>&1; then
    # Trim + fall back to $USER: an untrimmed acct once minted a SECOND
    # item under the same service (acct " austingriffith", sub2 2026-08-06)
    # — a split-brain store where each reader follows its own lineage and
    # one side's refresh eventually revokes the family.
    acct="$(security find-generic-password -s "$svc" 2>/dev/null \
      | sed -n 's/^ *"acct"<blob>="\(.*\)"$/\1/p' | head -1 \
      | awk '{$1=$1; print}')"
    acct="${acct:-$USER}"
    if ! security add-generic-password -U -s "$svc" ${acct:+-a "$acct"} -w "$blob" 2>/dev/null; then
      # In-place update refused (ACL) — clear the stale entry so reads
      # fall through to the fresh .credentials.json we just wrote.
      security delete-generic-password -s "$svc" >/dev/null 2>&1 || true
    fi
  fi
  echo "harvest: adopted rotated credential from $label for '$(basename "${dir:-default}")' (exp $vm_exp > $host_exp)"
}

cmd_harvest() {
  require_name "${1:-}"
  local name="$1" rec="$VM_ACCOUNTS_DIR/$1"
  [[ -f "$rec" ]] || { echo "harvest: no custody record for $name"; return 0; }
  local dir; dir="$(cat "$rec" 2>/dev/null || true)"; dir="${dir%/}"
  vm_running "$name" || { echo "harvest: $name not running — skipping"; return 0; }
  ensure_sshpass
  local blob
  blob="$(grab_vm_blob "$name" || true)"
  if [[ -z "$blob" ]]; then
    echo "harvest: no credential readable in $name — skipping"; return 0
  fi
  adopt_blob_for "$dir" "$blob" "$name" || true
}

# Re-stage the SELECTED login's credential into a RUNNING VM and record
# custody. This is the bounce path's missing half (found 2026-08-07):
# `cont up` on an existing agent disk boots whatever login the LAST
# provision left there — stale tokens the guest replays (doomed refresh →
# wiped blob → job runs unauthenticated) — and with no custody record,
# every host-side refresher believes that login is free while the guest
# contends for it. The wrangler calls this after every bounce. Guest-side
# install mirrors provisionAgent.sh's credential section exactly (clean
# delete+add for the ACL, partition list for non-Apple-signed binaries,
# file mirror, rc token export).
cmd_stage() {
  require_name "${1:-}"
  local name="$1"
  vm_running "$name" || { echo "stage: $name not running — boot it first" >&2; return 1; }
  ensure_sshpass
  # Refresh the staged copies from the selected login's live store so the
  # guest gets the CURRENT lineage tip, not whatever was staged last.
  local fresh
  if fresh="$(read_claude_token_from_keychain 2>/dev/null)"; then
    save_claude_token "$fresh"
  fi
  save_claude_credentials_blob >/dev/null 2>&1 || true
  save_claude_account_blob >/dev/null 2>&1 || true
  if [[ ! -f "$CLAUDE_CREDS_FILE" ]]; then
    echo "stage: no credential blob for the selected login — nothing to ship" >&2
    return 1
  fi
  local ip; ip="$(tart ip "$name" --wait 30)"
  local -a ssh_opts=(
    -o StrictHostKeyChecking=no
    -o UserKnownHostsFile=/dev/null
    -o LogLevel=ERROR
    -o PreferredAuthentications=password
    -o PubkeyAuthentication=no
    -o ConnectTimeout=8
    -o ServerAliveInterval=5
    -o ServerAliveCountMax=2
  )
  local stage; stage="$(mktemp -d)"
  trap "rm -rf '$stage'" RETURN
  cp "$CLAUDE_CREDS_FILE" "$stage/cont-claude-credentials.json"
  [[ -f "$CLAUDE_TOKEN_FILE" ]]   && cp "$CLAUDE_TOKEN_FILE"   "$stage/cont-claude-token"
  [[ -f "$CLAUDE_ACCOUNT_FILE" ]] && cp "$CLAUDE_ACCOUNT_FILE" "$stage/cont-claude-account.json"
  cat > "$stage/cont-stage-install.sh" <<'EOS'
#!/bin/bash
set -euo pipefail
CREDS_FILE="/tmp/cont-claude-credentials.json"
ACCOUNT_FILE="/tmp/cont-claude-account.json"
TOKEN_FILE="/tmp/cont-claude-token"
[[ -f "$CREDS_FILE" ]] || { echo "stage-install: no creds file shipped" >&2; exit 1; }
CREDS_JSON="$(cat "$CREDS_FILE")"
security unlock-keychain -p "admin" "$HOME/Library/Keychains/login.keychain-db" 2>/dev/null || true
security delete-generic-password -s "Claude Code-credentials" -a "$USER" \
  "$HOME/Library/Keychains/login.keychain-db" >/dev/null 2>&1 || true
security add-generic-password -A -s "Claude Code-credentials" -a "$USER" \
  -w "$CREDS_JSON" "$HOME/Library/Keychains/login.keychain-db"
security set-generic-password-partition-list -S "apple-tool:,apple:,teamid:" \
  -k "admin" -s "Claude Code-credentials" -a "$USER" \
  "$HOME/Library/Keychains/login.keychain-db" >/dev/null
mkdir -p "$HOME/.claude"
printf '%s' "$CREDS_JSON" > "$HOME/.claude/.credentials.json"
chmod 600 "$HOME/.claude/.credentials.json"
if [[ -f "$ACCOUNT_FILE" ]]; then
  python3 - "$ACCOUNT_FILE" "$HOME/.claude.json" <<'PY'
import json, os, sys
src, dst = sys.argv[1:]
patch = json.load(open(src))
base = json.load(open(dst)) if os.path.exists(dst) else {}
base.update(patch)
os.umask(0o077)
with open(dst, "w") as f:
    json.dump(base, f, indent=2)
os.chmod(dst, 0o600)
PY
fi
if [[ -f "$TOKEN_FILE" ]]; then
  TOKEN="$(tr -d '[:space:]' < "$TOKEN_FILE")"
  for rc in "$HOME/.zshrc" "$HOME/.zprofile"; do
    [[ -f "$rc" ]] || continue
    /usr/bin/sed -i '' '/CLAUDE_CODE_OAUTH_TOKEN=/d' "$rc"
    printf 'export CLAUDE_CODE_OAUTH_TOKEN=%q\n' "$TOKEN" >> "$rc"
  done
fi
rm -f "$CREDS_FILE" "$ACCOUNT_FILE" "$TOKEN_FILE"
echo "stage-install: credential installed"
EOS
  if ! tar cf - -C "$stage" . \
      | timeout 30 sshpass -p "$SSH_PASS" ssh "${ssh_opts[@]}" "$SSH_USER@$ip" \
          "cd /tmp && tar xf - --no-same-owner 2>/dev/null; true"; then
    echo "stage: transfer to $name failed" >&2; return 1
  fi
  if ! timeout 30 sshpass -p "$SSH_PASS" ssh -n "${ssh_opts[@]}" "$SSH_USER@$ip" \
      "bash /tmp/cont-stage-install.sh"; then
    echo "stage: guest install failed in $name" >&2; return 1
  fi
  # This VM now rides the selected login: all host-side refresh paths skip
  # it until cmd_down harvests (or keepalive reclaims) + releases.
  local sdir; sdir="$(claude_src_dir)"
  ( umask 077; printf '%s' "$sdir" > "$VM_ACCOUNTS_DIR/$name" )
  echo "stage: $name now rides '$(basename "${sdir:-default}")' (custody recorded)"
}

# Recover a login stranded inside a STOPPED custody VM (the guest rotated
# the refresh token mid-job and then halted itself — the wrangler's idle
# stop and the auditor agents' end-of-job self-shutdown both do this — so
# cmd_down's harvest never ran). Boot the VM just long enough to grab the
# blob, stop it IMMEDIATELY (so the guest can't rotate past our copy),
# adopt, and release custody. Returns 0 iff the login is safe to refresh
# host-side afterwards. Never boots past the 2-VM system cap.
reclaim_vm() {
  local name="$1" rec="$VM_ACCOUNTS_DIR/$1"
  [[ -f "$rec" ]] || return 0
  if ! vm_exists "$name"; then custody_release "$name"; return 0; fi
  if vm_running "$name"; then cmd_harvest "$name"; return 0; fi
  local nrun; nrun="$(tart list 2>/dev/null | awk '$1=="local" && $NF=="running"' | wc -l | tr -d ' ')"
  if (( nrun >= 2 )); then
    echo "reclaim: $name skipped — $nrun VMs already running (system cap)"; return 1
  fi
  local dir; dir="$(cat "$rec" 2>/dev/null || true)"; dir="${dir%/}"
  ensure_sshpass
  echo "reclaim: booting $name to recover '$(basename "${dir:-default}")' credential ..."
  nohup tart run --no-graphics "$name" </dev/null >/dev/null 2>&1 &
  disown || true
  local blob="" rc i empty_seen=0
  for i in $(seq 1 60); do
    rc=0; blob="$(grab_vm_blob "$name" 2>/dev/null)" || rc=$?
    [[ -n "$blob" ]] && break
    (( rc == 2 )) && empty_seen=$((empty_seen + 1))
    # Guest self-halted (its agent found no job) before we could read it.
    if (( i > 5 )) && ! vm_running "$name"; then break; fi
    sleep 2
  done
  tart stop "$name" >/dev/null 2>&1 || true
  if [[ -z "$blob" ]]; then
    if (( empty_seen >= 3 )); then
      # The guest ANSWERED, repeatedly: no credential on board. Its claude
      # wiped the blob after a rejected refresh (the usual case — a staged
      # copy going stale mid-custody) or it never had one; either way the
      # guest can never rotate this lineage again, so custody is moot and
      # the host copy — whatever its state — is the best there is. Before
      # this verdict existed, a wiped guest looked like a failed reclaim
      # and STRANDED a perfectly healthy host login forever (austinmax in
      # 'auditor', 2026-08-07).
      echo "reclaim: $name positively holds no credential — releasing custody (host copy stands)"
      custody_release "$name"
      return 0
    fi
    echo "reclaim: could not read credential from $name"; return 1
  fi
  # A readable blob whose tokens are EMPTY is claude's rejected-refresh wipe
  # signature — same verdict as absent. (Malformed JSON is NOT proof: fall
  # through and let adopt_blob_for reject it, keeping the login stranded.)
  if ! printf '%s' "$blob" | python3 -c '
import json, sys
try:
    o = json.load(sys.stdin).get("claudeAiOauth", {})
except Exception:
    sys.exit(0)  # malformed != provably wiped
sys.exit(0 if (o.get("accessToken") or o.get("refreshToken")) else 1)' 2>/dev/null; then
    echo "reclaim: $name blob is token-less (guest wiped it) — releasing custody (host copy stands)"
    custody_release "$name"
    return 0
  fi
  adopt_blob_for "$dir" "$blob" "$name" || return 1
  custody_release "$name"
}

# Keep every roster login alive and catch dead ones within hours instead
# of on the day the fleet needs them. For each login not in VM custody,
# account_headroom_fresh both validates and (when the access token has
# expired) refreshes via a real claude ping — advancing the refresh-token
# lineage so idle logins never rot. DEAD → Telegram (creds sourced from
# .env.notify beside this script), deduped to one alert per login per day.
# Anthropic hard-expires every OAuth refresh-token family 28 DAYS after
# /login — the blob's refreshTokenExpiresAt says exactly when, to the
# minute (sub4's 2026-08-07 16:57Z death matched the field EXACTLY).
# NOTHING extends it: not rotation, not real-client pings, not live usage
# (austinmax ran busy sessions for weeks and its deadline stayed frozen at
# its last /login + 28d). Keeping tokens fresh is necessary but not
# sufficient — the ONLY cure is a re-login before the horizon, so warn
# loudly while there is still time to do it calmly.
family_deadline_warn() {  # $1 = name, $2 = config dir
  local exp
  # `|| true`: under pipefail a login with NO credential (clawd) fails the
  # read half of this pipeline, and the failed assignment would set-e-kill
  # the whole script mid-roster (2026-08-07: keepalive silently stopped
  # after the second login and never checked the rest).
  exp="$(read_claude_blob_for "$2" 2>/dev/null | python3 -c '
import json, sys
try:
    o = json.load(sys.stdin)["claudeAiOauth"]
    if o.get("refreshToken") and o.get("refreshTokenExpiresAt"):
        print(int(o["refreshTokenExpiresAt"]))
except Exception:
    pass' 2>/dev/null)" || true
  [[ -n "$exp" ]] || return 0
  local now left human
  now="$(date +%s)"
  left=$(( exp / 1000 - now ))
  (( left > 0 && left < 5 * 86400 )) || return 0
  human="$(date -r $(( exp / 1000 )) '+%a %b %e %H:%M')"
  echo "SOON $1 — refresh-token family hard-expires $human (in $(( left / 3600 ))h); /login before then"
  keepalive_notify "family-$1" \
    "🟡 Claude login '$1' hard-expires $human (~$(( left / 3600 ))h left) — Anthropic's 28-day refresh-family limit, nothing on-box can extend it. Re-login BEFORE then: CLAUDE_CONFIG_DIR=~/.clawd-accounts/$1 claude /login"
}

account_keepalive() {
  local d name out vm dead=0
  while IFS= read -r d; do
    [[ "$d" == "-" ]] && d=""
    if [[ -z "$d" ]]; then name="default"; else name="$(basename "$d")"; fi
    # Deadline warning runs for EVERY login with a credential — including
    # ones skipped below for custody/live-claude: austinmax was busy with
    # live sessions (always SKIPped) while 4 days from its hard wall.
    family_deadline_warn "$name" "$d"
    if account_in_custody "$d"; then
      echo "SKIP $name — in custody of a running VM"
      continue
    fi
    # A custody record for a STOPPED (or vanished) VM means the guest may
    # have rotated the refresh token and stranded the lineage tip on its
    # disk. Refreshing host-side with our stale sibling would trip OAuth
    # reuse detection and REVOKE THE WHOLE FAMILY (how ef and sub2 died,
    # 2026-08-06) — so reclaim the blob from the VM first, and if that
    # fails, skip the ping entirely rather than kill the login.
    vm="$(custody_vm_for "$d" | head -1)"
    if [[ -n "$vm" ]]; then
      if ! reclaim_vm "$vm"; then
        echo "STRANDED $name — credential held by stopped VM $vm, reclaim failed; NOT refreshing (would revoke the lineage)"
        keepalive_notify "$name" \
          "🟠 Claude login '$name' is STRANDED in stopped VM '$vm' (reclaim failed) — fix: cont reclaim $vm"
        continue
      fi
    fi
    # A live claude process (a harness session, a hand-launched terminal)
    # owns this grant and renews it itself — pinging alongside it is the
    # two-consumers race that killed sub3 (2026-08-06).
    if claude_dir_live "$d"; then
      echo "SKIP $name — a live claude process owns this grant (it keeps the credential fresh)"
      continue
    fi
    if out="$(account_headroom_fresh "$d" 2>/dev/null)"; then
      echo "OK   $name — headroom ${out%% *}%"
    elif blob_has_tokens "$d"; then
      # Probe failed but the tokens are intact — endpoint 429/outage or a
      # lost lock race, NOT a dead login (austinmax was false-alarmed DEAD
      # this way 2026-08-06). A real revocation wipes the blob's tokens;
      # the next tick will see that and alert.
      echo "WARN $name — probe failed but credential intact (transient); not alerting"
    else
      echo "DEAD $name — no usable credential (re-login: CLAUDE_CONFIG_DIR=${d:-~/.claude} claude /login)"
      keepalive_notify "$name"
      dead=1
    fi
  done < <(account_roster)
  return "$dead"
}

blob_has_tokens() {  # $1 = config dir: blob exists and still carries tokens?
  read_claude_blob_for "$1" 2>/dev/null | python3 -c '
import json, sys
try:
    o = json.load(sys.stdin).get("claudeAiOauth", {})
except Exception:
    sys.exit(1)
sys.exit(0 if (o.get("accessToken") or o.get("refreshToken")) else 1)'
}

keepalive_notify() {  # $1 = account name, $2 = optional message; Telegram, 1 alert/login/day
  local envf="$SCRIPT_DIR/.env.notify"
  [[ -f "$envf" ]] || return 0
  # shellcheck disable=SC1090
  source "$envf" 2>/dev/null || return 0
  [[ -n "${TELEGRAM_BOT_TOKEN:-}" && -n "${TELEGRAM_CHAT_ID:-}" ]] || return 0
  local msg="${2:-🔴 Claude login '$1' is DEAD (refresh failed) — re-login with: CLAUDE_CONFIG_DIR=~/.clawd-accounts/$1 claude /login}"
  local stamp="$CONFIG_DIR/keepalive-alerted-$1" now last
  now="$(date +%s)"; last="$(cat "$stamp" 2>/dev/null || echo 0)"
  (( now - last < 86400 )) && return 0
  echo "$now" > "$stamp"
  curl -fsS -m 10 "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
    -d chat_id="${TELEGRAM_CHAT_ID}" \
    -d text="$msg" \
    >/dev/null 2>&1 || true
}

account_switch() {  # $1 = config dir ("" = default)
  local dir="${1%/}"
  if ! read_claude_blob_for "$dir" >/dev/null 2>&1; then
    echo "error: no credential (keychain or .credentials.json) for '${dir:-default}'" >&2
    return 1
  fi
  ( umask 077; printf '%s' "$dir" > "$CLAUDE_SRC_FILE" )
  # Drop staged copies of the previous account and restage from the new one.
  rm -f "$CLAUDE_TOKEN_FILE" "$CLAUDE_CREDS_FILE" "$CLAUDE_ACCOUNT_FILE"
  local token
  if token="$(read_claude_token_from_keychain)"; then
    save_claude_token "$token"
  fi
  save_claude_credentials_blob || true
  save_claude_account_blob || true
  echo "fleet Claude account -> $(claude_src_name)"
}

# Switch to the account whose subscription POOL has the most headroom.
# Pool = org (see account_org): sibling dirs share one usage window, so
# one probe prices the whole pool and hopping between siblings is never a
# hop. Policy (2026-08-18, replaces the old default-blacklist):
#   - every pool is fair game — the goal is a headroom FLOOR
#     (CONT_MIN_HEADROOM, default 15%) on every pool, not a fenced-off dir;
#   - a pool with a dir held by a RUNNING VM is skipped: stacking new work
#     on a pool that's already burning is how a window gets pinned at 100%;
#   - within a pool, named dirs are preferred over `default` (~/.claude) —
#     same budget, but custody rotation on the human's interactive login
#     is a mechanical risk worth avoiding when a sibling exists.
# Prints the new account name and exits 0 ONLY if that changed the
# selection to a dir whose pool has >= the floor; exits 1 otherwise — so
# the wrangler can fall back to pausing.
account_auto() {
  local min="${CONT_MIN_HEADROOM:-15}"
  local excl=",${CONT_EXCLUDE_ACCOUNTS:-},"
  local cur rows="" busy="|" done_pools="|" unknown="|" cur_org d name org rank rc out hr
  cur="$(claude_src_dir)"
  while IFS= read -r d; do
    [[ "$d" == "-" ]] && d=""
    if [[ -z "$d" ]]; then name="default"; else name="$(basename "$d")"; fi
    # Explicit exclusions (CONT_EXCLUDE_ACCOUNTS=name1,name2).
    [[ "$excl" == *",$name,"* ]] && continue
    org="$(account_org "$d" 2>/dev/null | cut -f1)" || true
    [[ -n "$org" ]] || org="?$name"  # no bound account: its own pool
    # Custody (a running VM holds this credential): don't probe it (the
    # probe's refresh races the in-guest copy) and mark the whole pool
    # busy — its window is already being spent.
    if account_in_custody "$d"; then busy="$busy$org|"; continue; fi
    # rank makes named dirs sort before default within a pool
    if [[ -z "$d" ]]; then rank="1-default"; else rank="0-$name"; fi
    rows="$rows$org	$rank	$d
"
  done < <(account_roster)

  local best_hr="-1" best_dir="__none__"
  while IFS='	' read -r org rank d; do
    [[ -n "$org" ]] || continue
    [[ "$busy" == *"|$org|"* ]] && continue
    [[ "$done_pools" == *"|$org|"* ]] && continue  # pool already priced
    rc=0; out="$(account_headroom_fresh "$d" 2>/dev/null)" || rc=$?
    if (( rc == 4 )); then
      # Endpoint rate-limited — the login may be perfectly healthy. On
      # 2026-08-18 a burst of probes 429'd sub5 (100% headroom), auto
      # read it as dead, and the fallback burned a healthy pool's sibling.
      sleep 20
      rc=0; out="$(account_headroom_fresh "$d" 2>/dev/null)" || rc=$?
    fi
    if (( rc == 4 )); then unknown="$unknown$org|"; continue; fi
    (( rc != 0 )) && continue  # dead dir: try a pool sibling
    done_pools="$done_pools$org|"
    hr="${out%% *}"
    if awk -v a="$hr" -v b="$best_hr" 'BEGIN{exit !(a>b)}'; then
      best_hr="$hr"; best_dir="$d"
    fi
  done < <(printf '%s' "$rows" | sort)

  # Don't move on unknown: if the CURRENT pool's probe was rate-limited it
  # may be perfectly healthy — hopping off it on a 429 is how this run's
  # own verification moved the fleet from a 70% pool to a 19% one. Keep
  # the selection; the wrangler retries auto and a later probe decides.
  cur_org="$(account_org "$cur" 2>/dev/null | cut -f1)" || true
  if [[ -n "$cur_org" && "$unknown" == *"|$cur_org|"* ]]; then
    echo "account auto: current pool's usage endpoint is rate-limited — keeping the current selection, retry later" >&2
    return 1
  fi
  if [[ "$best_dir" == "__none__" ]] \
      || ! awk -v h="$best_hr" -v m="$min" 'BEGIN{exit !(h>=m)}'; then
    echo "account auto: no subscription pool has ≥${min}% headroom (pools already burning under a running VM are skipped) — pausing beats draining a pool to zero" >&2
    return 1
  fi
  if [[ -z "$best_dir" ]]; then
    echo "account auto: selecting default (~/.claude) — last living dir of its pool; consider reviving a sibling dir" >&2
  fi
  [[ "$best_dir" == "$cur" ]] && return 1
  account_switch "$best_dir" >&2 || return 1
  claude_src_name
}

cmd_account() {
  local sub="${1:-show}"
  case "$sub" in
    show)
      local dir; dir="$(claude_src_dir)"
      echo "account:  $(claude_src_name)"
      echo "config:   ${dir:-$HOME/.claude (default)}"
      echo "keychain: $(claude_keychain_service)"
      ;;
    dir)     claude_src_dir; echo ;;
    service) claude_keychain_service ;;
    blob)    read_claude_blob_for "$(claude_src_dir)" ;;
    list)
      local d name cur out mark rc orgname
      cur="$(claude_src_dir)"
      while IFS= read -r d; do
        [[ "$d" == "-" ]] && d=""
        if [[ -z "$d" ]]; then name="default"; else name="$(basename "$d")"; fi
        mark=" "; [[ "$d" == "$cur" ]] && mark="*"
        orgname="$(account_org "$d" 2>/dev/null | cut -f2)" || true
        [[ -n "$orgname" ]] || orgname="?"
        rc=0; out="$(account_headroom_fresh "$d" 2>/dev/null)" || rc=$?
        if (( rc == 0 )); then
          printf '%s %-10s pool %-32s headroom %s%%   worst window resets %s\n' \
            "$mark" "$name" "$orgname" "${out%% *}" "${out#* }"
        elif (( rc == 4 )); then
          printf '%s %-10s pool %-32s (usage endpoint rate-limited — login likely fine, retry later)\n' "$mark" "$name" "$orgname"
        else
          printf '%s %-10s pool %-32s (no usable credential)\n' "$mark" "$name" "$orgname"
        fi
      done < <(account_roster)
      ;;
    auto)
      account_auto
      ;;
    keepalive)
      account_keepalive
      ;;
    default)
      account_switch ""
      ;;
    *)
      local dir="$sub"
      [[ "$dir" != /* ]] && dir="$ACCOUNTS_DIR/$sub"
      [[ -d "$dir" ]] || { echo "error: no such account dir: $dir" >&2; exit 2; }
      account_switch "$dir"
      ;;
  esac
}

cmd_pull() {
  local img="${1:-$UPSTREAM_BASE}"
  echo "pulling $img ..."
  tart pull "$img"
  echo "ok. configured base is: $(current_base)"
}

cmd_base() {
  if [[ -z "${1:-}" ]]; then
    echo "$(current_base)"
    return
  fi
  echo "$1" > "$BASE_FILE"
  echo "base image set to: $1"
}

cmd_list() {
  tart list
}

ensure_clone() {
  local name="$1" base; base="$(current_base)"
  if ! vm_exists "$name"; then
    echo "cloning $base -> $name ..."
    tart clone "$base" "$name"
  fi
  apply_spec "$name"
}

cmd_up() {
  require_name "${1:-}"
  local name="$1"
  ensure_clone "$name"
  if vm_running "$name"; then
    echo "$name already running"; return
  fi
  local log="/tmp/cont-$name.log"
  echo "booting $name (headless) ..."
  nohup tart run --no-graphics "$name" </dev/null >"$log" 2>&1 &
  local pid=$!
  disown "$pid" 2>/dev/null || true
  # Wait until the VM registers as running, OR tart exits (boot failure —
  # e.g. "VMs exceed the system limit" when 2+ other VMs are already up).
  for _ in $(seq 1 30); do
    if vm_running "$name"; then
      echo "started. log: $log"
      return
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      echo "error: tart run exited before $name reached running state." >&2
      echo "--- last lines of $log ---" >&2
      tail -10 "$log" >&2
      echo "--- running VMs (system cap is typically 2) ---" >&2
      tart list 2>&1 | awk 'NR==1 || $NF=="running"' >&2
      exit 1
    fi
    sleep 1
  done
  echo "error: $name didn't reach running state within 30s." >&2
  echo "--- last lines of $log ---" >&2
  tail -10 "$log" >&2
  exit 1
}

cmd_open() {
  require_name "${1:-}"
  local name="$1"
  ensure_clone "$name"
  if vm_running "$name"; then
    echo "$name already running — stopping so it can be re-opened with a window"
    tart stop "$name" >/dev/null 2>&1 || true
    sleep 2
  fi
  local log="/tmp/cont-$name.log"
  : > "$log"
  echo "starting $name with VNC ..."
  nohup tart run --vnc-experimental "$name" </dev/null >"$log" 2>&1 &
  disown || true
  # wait for tart to print the vnc:// URL (tart already calls `open` on it,
  # but we re-`open` to be sure Screen Sharing.app comes to the front)
  for _ in $(seq 1 30); do
    if grep -q "vnc://" "$log"; then
      local url; url="$(grep -oE 'vnc://[^[:space:]]+' "$log" | head -1 | sed 's/\.\.\.$//')"
      echo "opening $url in Screen Sharing"
      open "$url"
      return
    fi
    sleep 1
  done
  echo "warning: tart didn't print a vnc URL within 30s — see $log"
  return 1
}

cmd_down() {
  require_name "${1:-}"
  # Harvest the (possibly rotated) Claude credential back before the VM
  # dies with it — see "Credential custody". Best-effort, never blocks
  # the stop.
  if [[ -f "$VM_ACCOUNTS_DIR/$1" ]] && vm_running "$1"; then
    timeout 45 "$self" harvest "$1" 2>&1 || echo "harvest: failed for $1 (continuing with stop)" >&2
  fi
  tart stop "$1"
  # Custody record deliberately survives a stop: the stopped VM still has
  # the blob on disk and may boot again (the wrangler's post-provision
  # bounce does exactly that). Only cmd_rm / a re-provision end custody.
}

cmd_rm() {
  require_name "${1:-}"
  if vm_running "$1"; then
    if [[ -f "$VM_ACCOUNTS_DIR/$1" ]]; then
      timeout 45 "$self" harvest "$1" 2>&1 || true
    fi
    tart stop "$1" || true
  elif [[ -f "$VM_ACCOUNTS_DIR/$1" && "${CONT_NO_RECLAIM:-}" != "1" ]]; then
    # Stopped VM still holding a login: the guest may have rotated the
    # refresh token and self-halted (auditor agents do), making its disk
    # the lineage tip. Deleting it now would strand the login for good —
    # boot-grab-stop first. CONT_NO_RECLAIM=1 skips (accepting the loss).
    reclaim_vm "$1" \
      || echo "rm: reclaim failed for $1 — deleting anyway (its login may need re-auth)" >&2
  fi
  custody_release "$1"
  tart delete "$1"
}

cmd_reset() {
  require_name "${1:-}"
  local name="$1"
  if vm_exists "$name"; then cmd_rm "$name"; fi
  cmd_up "$name"
}

cmd_snapshot() {
  require_name "${1:-}"
  require_name "${2:-}"
  local from="$1" to="$2"
  if vm_running "$from"; then
    echo "stopping $from before snapshot ..."
    tart stop "$from"
  fi
  tart clone "$from" "$to"
  echo "snapshotted $from -> $to"
}

cmd_clone() {
  cmd_snapshot "$@"
}

cmd_ip() {
  require_name "${1:-}"
  tart ip "$1"
}

cmd_ssh() {
  require_name "${1:-}"
  local name="$1"; shift || true
  ensure_sshpass
  local ip; ip="$(tart ip "$name" --wait 30)"
  sshpass -p "$SSH_PASS" ssh \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    -o LogLevel=ERROR \
    -o PreferredAuthentications=password \
    -o PubkeyAuthentication=no \
    "$SSH_USER@$ip" "$@"
}

# Boot the VM if needed, scp a script in, and run it. Default script is
# $SCRIPT_DIR/provision.sh; pass an explicit path to override.
cmd_provision() {
  require_name "${1:-}"
  local name="$1" script
  script="${2:-$SCRIPT_DIR/provision.sh}"
  if [[ ! -f "$script" ]]; then
    echo "error: no provision script at $script" >&2; exit 2
  fi

  if ! vm_running "$name"; then
    cmd_up "$name"
  fi

  ensure_sshpass
  local ip; ip="$(tart ip "$name" --wait 60)"

  # Fresh-VM ssh isn't actually ready the moment the VM reports running:
  # launchd is still bringing sshd up, so the first scp races and dies
  # with "Connection closed by remote host". Settle, then probe until
  # ssh actually answers before any scp. Same pattern as bake-agent-gold.sh.
  # Let sshd fully settle before we touch it. Every SSH connection counts
  # against macOS's rate limiter, so no separate probe — go straight into
  # the tar transfer with retries.
  echo "==> waiting 10s for $name ($ip) sshd to settle ..."
  sleep 10

  # ── SSH helpers (plain sshpass, no multiplexing) ────────────────────
  # sshpass + ControlMaster doesn't work (sshpass can't handle -fN).
  # Instead we use tar|ssh for directories (single connection per dir)
  # to avoid the scp -r connection-exhaustion that caused 148 failures.
  local -a ssh_opts=(
    -o StrictHostKeyChecking=no
    -o UserKnownHostsFile=/dev/null
    -o LogLevel=ERROR
    -o PreferredAuthentications=password
    -o PubkeyAuthentication=no
  )
  _vssh() { sshpass -p "$SSH_PASS" ssh "${ssh_opts[@]}" "$SSH_USER@$ip" "$@"; }
  _vscp() {
    local src="$1" dst="$2"
    sshpass -p "$SSH_PASS" scp "${ssh_opts[@]}" "$src" "$SSH_USER@$ip:$dst"
  }
  # tar|ssh: pack locally, stream over one SSH connection, unpack remotely.
  # Replaces scp -r which opened per-file connections and got rate-limited.
  _vtar() {
    local src_dir="$1" dst_dir="$2"
    tar cf - -C "$(dirname "$src_dir")" "$(basename "$src_dir")" \
      | sshpass -p "$SSH_PASS" ssh "${ssh_opts[@]}" "$SSH_USER@$ip" \
          "rm -rf '$dst_dir' && mkdir -p '$(dirname "$dst_dir")' && cd '$(dirname "$dst_dir")' && tar xf -"
  }

  # ── Bundle EVERYTHING into one tar stream over one SSH connection ────
  # Old approach: 15+ individual scp calls + scp -r for dirs = 20+ SSH
  # handshakes. macOS sshd rate-limits after ~10-15 rapid connections.
  # Fix: collect all files into a staging dir, tar|ssh the lot in ONE go.
  local script_dir; script_dir="$(cd "$(dirname "$script")" && pwd)"
  local script_name; script_name="$(basename "$script")"
  local stage; stage="$(mktemp -d)"
  trap "rm -rf '$stage'" RETURN

  # Individual files → flat in staging dir
  local seen_files=" "
  local f fname
  for f in "$script" "$script_dir"/provision*.sh "$script_dir"/.env* "$script_dir"/*.prompt.md; do
    [[ -f "$f" ]] || continue
    case "$f" in *.example|*.sample) continue ;; esac
    fname="$(basename "$f")"
    case "$seen_files" in *" $fname "*) continue ;; esac
    seen_files+="$fname "
    cp "$f" "$stage/$fname"
  done

  # Directories → preserve structure in staging dir
  local d
  for d in scripts skills; do
    [[ -d "$script_dir/$d" ]] || continue
    cp -a "$script_dir/$d" "$stage/$d"
  done

  # Claude credentials → renamed in staging dir
  if [[ -f "$CLAUDE_TOKEN_FILE" || -f "$CLAUDE_CREDS_FILE" ]]; then
    save_claude_credentials_blob >/dev/null 2>&1 || true
    save_claude_account_blob >/dev/null 2>&1 || true
    local fresh
    if fresh="$(read_claude_token_from_keychain 2>/dev/null)"; then
      save_claude_token "$fresh"
    fi
  fi
  [[ -f "$CLAUDE_TOKEN_FILE" ]]   && cp "$CLAUDE_TOKEN_FILE"   "$stage/cont-claude-token"
  [[ -f "$CLAUDE_CREDS_FILE" ]]   && cp "$CLAUDE_CREDS_FILE"   "$stage/cont-claude-credentials.json"
  [[ -f "$CLAUDE_ACCOUNT_FILE" ]] && cp "$CLAUDE_ACCOUNT_FILE" "$stage/cont-claude-account.json"

  # Record credential custody: this VM now rides the selected login. All
  # host-side refresh paths skip it until cmd_down harvests + releases.
  if [[ -f "$stage/cont-claude-credentials.json" || -f "$stage/cont-claude-token" ]]; then
    ( umask 077; printf '%s' "$(claude_src_dir)" > "$VM_ACCOUNTS_DIR/$name" )
  fi

  # Ship it — ONE ssh connection, ONE tar stream, with retry
  local _nfiles; _nfiles="$(find "$stage" -type f | wc -l | tr -d ' ')"
  local _ndirs;  _ndirs="$(find "$stage" -type d -mindepth 1 | wc -l | tr -d ' ')"
  local _attempt
  for _attempt in 1 2 3; do
    echo "==> syncing ${_nfiles} files + ${_ndirs} dirs to $name:/tmp/ (attempt ${_attempt}/3) ..."
    if tar cf - -C "$stage" . \
      | sshpass -p "$SSH_PASS" ssh "${ssh_opts[@]}" "$SSH_USER@$ip" \
          "cd /tmp && tar xf - --no-same-owner 2>/dev/null; true"; then
      break
    fi
    echo "    transfer failed, waiting 5s before retry ..."
    sleep 5
  done

  local fast_env=""
  if [[ "${CONT_PROVISION_FAST:-}" == "1" ]]; then
    fast_env="CONT_PROVISION_FAST=1 "
  fi
  # Forward the per-agent env filename so one provisioner can serve
  # multiple instances of the same agent type (auditor vs auditor2).
  if [[ -n "${AGENT_ENV_FILE:-}" ]]; then
    fast_env="${fast_env}AGENT_ENV_FILE='${AGENT_ENV_FILE}' "
  fi

  echo "==> running ${fast_env}$script_name in $name ..."
  _vssh "${fast_env}bash /tmp/$script_name && sync && sync"
}

# Sync — re-run the per-agent provisioner in FAST mode. Used after cloning
# a per-agent gold image, when only the volatile per-job state (scripts,
# skills, env, prompt, Claude OAuth) needs refreshing. Same arguments as
# `cont provision`. ~5–10s vs ~30–60s for a full provision.
cmd_sync() {
  CONT_PROVISION_FAST=1 cmd_provision "$@"
}

cmd_spec() {
  require_name "${1:-}"
  local name="$1" file; file="$(spec_file "$name")"
  shift
  if (( $# == 0 )); then
    echo "# spec: $file"
    if [[ -f "$file" ]]; then cat "$file"; else echo "(none — VM uses tart defaults)"; fi
    if vm_exists "$name"; then
      echo
      echo "# live config from tart get:"
      tart get "$name"
    fi
    return
  fi
  if [[ "$1" == "edit" ]]; then
    : > /dev/null
    "${EDITOR:-vi}" "$file"
    return
  fi
  if [[ "$1" == "clear" ]]; then
    rm -f "$file"; echo "removed $file"; return
  fi
  # k=v pairs: write/replace each in the spec file
  for kv in "$@"; do
    [[ "$kv" == *=* ]] || { echo "expected key=value, got: $kv" >&2; exit 2; }
    local k="${kv%%=*}" v="${kv#*=}"
    case "$k" in
      cpu|memory|display|disk) ;;
      *) echo "unknown key '$k' (allowed: cpu memory display disk)" >&2; exit 2 ;;
    esac
    touch "$file"
    if grep -qE "^[[:space:]]*$k[[:space:]]*=" "$file"; then
      # macOS sed needs an empty backup arg
      sed -i '' -E "s|^[[:space:]]*$k[[:space:]]*=.*|$k=$v|" "$file"
    else
      printf '%s=%s\n' "$k" "$v" >> "$file"
    fi
  done
  echo "spec updated: $file"
  if vm_exists "$name" && ! vm_running "$name"; then apply_spec "$name"; fi
}

cmd_status() {
  echo "configured base: $(current_base)"
  echo
  tart list
}

usage() {
  cat <<'EOF'
cont — programmatic macOS-on-macOS environments via tart

  cont pull [image]           pull base image (default: cirruslabs tahoe)
  cont base [image]           show or set the base image used for `up`
  cont auth [ensure|show|path|clear]
                              ensure (default) runs `claude setup-token` if no
                              valid token saved; the token is auto-injected
                              into VMs by `cont provision`
  cont account [show|list|auto|keepalive|default|<name>]
                              which Claude login the fleet ships into VMs:
                              a harness account dir (~/.clawd-accounts/<name>)
                              or `default` (~/.claude). `list` shows usage
                              headroom per login; `auto` hops to the one with
                              the most headroom (exit 1 if none >= 15%;
                              skips logins in VM custody); `keepalive`
                              refresh-pings every idle login and alerts on
                              dead ones (run it from cron/launchd)
  cont harvest <name>         pull the VM's (possibly rotated) Claude
                              credential back into the host store; runs
                              automatically inside `cont down`/`cont rm`
  cont reclaim <name>         recover a login stranded in a STOPPED custody
                              VM: boot, grab the blob, stop immediately,
                              adopt; runs automatically from keepalive/rm
  cont stage <name>           re-stage the SELECTED login's credential into
                              a RUNNING VM + record custody; the wrangler
                              runs it after every bounce (`cont up` on an
                              existing agent disk boots stale creds)
  cont list                   list all VMs and their status
  cont status                 show base + list
  cont up <name>              clone base -> name (if missing) and boot
  cont down <name>            stop a VM
  cont reset <name>           delete and recreate from base
  cont rm <name>              delete a VM
  cont snapshot <from> <to>   APFS-clone a VM (also: `clone`)
  cont ip <name>              print VM IP
  cont ssh <name> [cmd...]    ssh in (admin/admin)
  cont open <name>            boot if needed and bring GUI window to front
  cont provision <name> [s]   boot if needed, scp script in, run it (default: ./provision.sh)
  cont sync <name> [s]        same as provision but FAST=1 (skip Tier-2 installs;
                              expects per-agent gold image to already have them)
  cont spec <name>            show spec + live config
  cont spec <name> k=v ...    set keys (cpu memory display disk); applies if stopped
  cont spec <name> edit       open spec file in $EDITOR
  cont spec <name> clear      remove the spec file
EOF
}

main() {
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    pull)     cmd_pull "$@" ;;
    base)     cmd_base "$@" ;;
    auth)     cmd_auth "$@" ;;
    account)  cmd_account "$@" ;;
    harvest)  cmd_harvest "$@" ;;
    stage)    cmd_stage "$@" ;;
    reclaim)  require_name "${1:-}"; reclaim_vm "$1" ;;
    list|ls)  cmd_list ;;
    status)   cmd_status ;;
    up|start) cmd_up "$@" ;;
    down|stop)cmd_down "$@" ;;
    reset)    cmd_reset "$@" ;;
    rm|delete)cmd_rm "$@" ;;
    snapshot|clone) cmd_snapshot "$@" ;;
    ip)       cmd_ip "$@" ;;
    ssh|shell)cmd_ssh "$@" ;;
    open|gui) cmd_open "$@" ;;
    provision)cmd_provision "$@" ;;
    sync)     cmd_sync "$@" ;;
    spec)     cmd_spec "$@" ;;
    ""|-h|--help|help) usage ;;
    *) echo "unknown: $cmd" >&2; usage; exit 2 ;;
  esac
}

main "$@"
