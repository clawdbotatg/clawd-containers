# .env.research — secrets for the research agent.
#
# Copy this file to `.env.research` and fill in the values. The real
# file is gitignored. Standard shell `KEY=value` lines — sourced by
# ~/.zprofile in the VM, present in every login shell.

# Private key the research agent signs leftclaw txs with (acceptJob,
# completeJob, logWork). Funded on Base mainnet.
PRIVATE_KEY=0xREPLACE_ME

# BGIPFS API key (X-API-Key header) used by ~/scripts/bgipfs/upload.sh
# to publish the final report.
BGIPFS_KEY=REPLACE_ME

# Base mainnet RPC. Used for any on-chain data the report cites and for
# the leftclaw on-chain scripts. Get a free key at
# https://dashboard.alchemy.com.
ALCHEMY_API_KEY=REPLACE_ME
