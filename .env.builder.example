# .env.builder — secrets for the builder agent (Service Type 6).
#
# Copy this file to `.env.builder` and fill in the values. Real file is
# gitignored. Standard shell `KEY=value` lines — sourced by ~/.zprofile
# in the VM, present in every login shell.

# Private key the builder signs leftclaw txs with (acceptJob, completeJob,
# logWork) AND the deployer key for the contracts it builds. Funded on
# Base mainnet with enough ETH for deployments + verification.
PRIVATE_KEY=0xREPLACE_ME

# BGIPFS API key (X-API-Key header) used by ~/scripts/bgipfs/upload.sh
# AND by `npx bgipfs` inside the builds (the SE2 build pipeline uploads
# the static frontend export).
BGIPFS_KEY=REPLACE_ME

# Base mainnet RPC. Used by leftclaw scripts AND by SE2 deployments
# (`yarn deploy --network base` and `yarn verify --network base`).
ALCHEMY_API_KEY=REPLACE_ME

# GitHub PAT for the bot account that owns the generated repos
# (clawdbotatg by default). Required scopes: repo, workflow,
# delete_repo. The builder uses it to:
#   - gh repo create <user>/leftclaw-service-job-N --public
#   - git push to that repo
#   - gh issue create for audit findings (Medium+ severity)
GITHUB_TOKEN=ghp_REPLACE_ME

# GitHub user the bot operates as. Must own the GITHUB_TOKEN above.
# Used as the org owner in `gh repo create $GITHUB_USER/...`.
GITHUB_USER=clawdbotatg
