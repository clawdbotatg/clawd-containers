# .env.frontend-qa — secrets for the frontend QA agent.
#
# Copy this file to `.env.frontend-qa` and fill in the values. Real
# file is gitignored. Standard shell `KEY=value` lines — sourced by
# ~/.zprofile in the VM, present in every login shell.

# Private key the QA agent signs leftclaw txs with (acceptJob,
# completeJob, logWork). Funded on Base mainnet.
PRIVATE_KEY=0xREPLACE_ME

# BGIPFS API key (X-API-Key header) used by ~/scripts/bgipfs/upload.sh
# to publish the QA report.
BGIPFS_KEY=REPLACE_ME

# Base mainnet RPC. Used by leftclaw on-chain scripts and any contract
# data the QA report cites.
ALCHEMY_API_KEY=REPLACE_ME

# Test wallet for actual user-flow QA (separate from PRIVATE_KEY which
# is the worker-of-record wallet). Only needed for Phase 2 once
# MetaMask is wired into the image. Leave as REPLACE_ME for now —
# Phase 1 does code-level + visual-only QA without a connected wallet.
TEST_WALLET_PRIVATE_KEY=0xREPLACE_ME
