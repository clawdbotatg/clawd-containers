# .env.auditor — secrets for the auditor agent.

# Private key the auditor signs leftclaw txs with (acceptJob, completeJob,
# logWork). Funded on Base mainnet. Do NOT commit the real value.
PRIVATE_KEY=0xREPLACE_ME

# BGIPFS API key (X-API-Key header) used by ~/scripts/bgipfs/upload.sh.
BGIPFS_KEY=REPLACE_ME

# Base mainnet RPC. Used by every leftclaw on-chain script. Get a free
# key at https://dashboard.alchemy.com.
ALCHEMY_API_KEY=REPLACE_ME