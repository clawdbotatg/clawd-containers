# .env.feature — secrets for the feature agent (Service Type 10).
#
# Copy this file to `.env.feature` and fill in the values. Real file is
# gitignored. Standard shell `KEY=value` lines — sourced by ~/.zprofile
# in the VM, present in every login shell.

# Private key the feature agent signs leftclaw txs with (acceptJob,
# completeJob, logWork) AND the deployer key when an SE2 dApp's contract
# changes are part of the feature. Funded on Base mainnet with enough ETH
# for occasional redeploys + verification.
PRIVATE_KEY=0xREPLACE_ME

# BGIPFS API key (X-API-Key header) used by ~/scripts/bgipfs/upload.sh
# AND by `npx bgipfs` inside the builds.
BGIPFS_KEY=REPLACE_ME

# Base mainnet RPC. Used by leftclaw scripts AND by SE2 deployments.
ALCHEMY_API_KEY=REPLACE_ME

# GitHub PAT for the bot account. Required scopes: repo, workflow.
# delete_repo is NOT required (the feature agent never deletes repos).
# The agent uses it to:
#   - clone existing repos (leftclaw deliverables and external upstreams)
#   - gh repo fork <upstream> (idempotent — for external-mode features)
#   - git push to the leftclaw repo (leftclaw mode) or the bot's fork (external mode)
#   - gh pr create against the upstream (external mode)
#
# IMPORTANT: this PAT can push to ANY clawdbotatg/* repo, including
# products we built outside of leftclaw. The feature agent's
# scripts/feature/resolve-target.sh + scripts/feature/push.sh enforce
# that we only push to clawdbotatg/leftclaw-service-job-<N> repos in
# direct mode. Do not weaken those scripts.
GITHUB_TOKEN=ghp_REPLACE_ME

# GitHub user the bot operates as. Must own the GITHUB_TOKEN above.
GITHUB_USER=clawdbotatg
